def todo_sections(lines):
    """Галочки docs/TODO.md по группам заголовков — порт statusline-block.sh.

    Разбор повторяет тот, по которому те же числа показывает статуслайн
    (skill-do, `statusline-block.sh`, а до него claude-statusline-todo): делим
    по заголовку первого уровня, считаем галочки нулевой колонки, пустые
    секции выбрасываем. Расходиться этим двум ответам нельзя — человек читает
    их об одном и том же файле, и второй счёт был бы не второй колонкой, а
    поводом не верить обеим.

    Метка приводится к нижнему регистру и теряет хвостовое двоеточие: она
    встаёт рядом с числом в строке списка, а не цитируется дословно.

    Пустая метка значит «называть нечем» — галочки до первого заголовка, — а
    не «секции нет». Пустой список значит «счёта нет вовсе», и читатель обязан
    не рисовать колонку, а не показывать 0/0.
    """
    out, cur = [], None
    for line in lines:
        m = TODO_H1_RE.match(line)
        if m:
            cur = {"label": m.group(1).rstrip(":").strip().lower(),
                   "done": 0, "todo": 0}
            out.append(cur)
            continue
        done = bool(TODO_DONE_RE.match(line))
        if not done and not TODO_OPEN_RE.match(line):
            continue
        if cur is None:
            cur = {"label": "", "done": 0, "todo": 0}
            out.append(cur)
        cur["done" if done else "todo"] += 1
    return [s for s in out if s["done"] + s["todo"]]


def project_todo(cwd):
    """Счётчики docs/TODO.md проекта, или пустота, если считать нечего.

    Файла нет у двадцати проектов из сорока пяти на живой машине, и это не
    исключительный случай, а обычный: пустой ответ здесь — не ошибка.
    Читается файл целиком, и это дёшево — замер на той же машине: 25 файлов,
    82 КБ, 3.8 мс на весь список. Памятка по mtime стоила бы дороже самой
    работы.
    """
    try:
        with open(os.path.join(cwd, TODO_REL), encoding="utf-8",
                  errors="replace") as fh:
            return todo_sections(fh)
    except (OSError, ValueError):
        return []


def todo_memo(read=None):
    """Счётчики по каталогу, с памятью на один ответ.

    Счёт нужен и строкам проектов, и строкам сессий: человек читает его в том
    же списке, где и работает, а список этот — сессии. Сессий сто, каталогов
    под полсотни, и без памяти один и тот же docs/TODO.md перечитывался бы по
    разу на каждую строку — на горячем пути, который зовут раз в секунду по
    ssh.

    Пустой ответ запоминается наравне с непустым: каталогов без docs/TODO.md
    почти половина, и именно они дали бы больше всего лишних заходов.

    Память живёт ровно один вызов режима и наружу не выносится: файл человек
    правит прямо во время работы, и счёт, застрявший на весь век процесса, врал
    бы ровно тому, кто галочки и ставит.
    """
    read = read or project_todo
    cache = {}

    def at(cwd):
        if cwd not in cache:
            cache[cwd] = read(cwd)
        return cache[cwd]

    return at


def project_at(files, age_of=None):
    """Когда в проекте последний раз разговаривали — по содержимому, не mtime.

    mtime здесь не годится ровно по той причине, которая расписана у
    `last_message_at`: в хвосте живого транскрипта лежат служебные записи без
    времени — last-prompt, custom-title, mode, pr-link, — и Claude Code
    переписывает их спустя дни после последней реплики. Строка проекта была
    последним местом, которое всё ещё верило mtime, и наверх списка всплывали
    проекты с открытым окном, где работы не было часами.

    Обход точный, а не выборочный, и всё же почти всегда стоит одного чтения.
    Время записи не может быть позже, чем момент, когда её дописали в файл, то
    есть `last_message_at(f) <= mtime(f)` всегда; `files` приходит от
    `scan_dirs` уже отсортированным по mtime убыванием. Значит, как только
    накопленный ответ достиг mtime следующего файла, ни один из оставшихся его
    не обгонит — и остановиться здесь можно, ничего не потеряв. Без остановки
    это хвост по TAIL у каждого транскрипта проекта, а их в одном каталоге
    бывает под сотню.

    Ноль — «возраст неизвестен» (в хвосте нет ни одной записи со временем), и
    такой файл обход просто пропускает. Что делать, когда ноль дали все,
    решает вызывающий: здесь для этого нет данных, а `ago` по нулю рисует
    1970 год.
    """
    age_of = age_of or last_message_at
    best = 0.0
    for path, mtime in files:
        if best >= mtime:
            break
        at = age_of(path) or 0.0
        if at > best:
            best = at
    return best


def project_rows(dirs, live, marks, age_of=None, todo_at=None):
    """One row per project: marks and directories with sessions, newest first."""
    agg = {}
    for entry in dirs:
        # Возраст считается один раз на каталог, а не на владельца: `owners_of`
        # отдаёт и сам проект, и его закладки-предки, и без этого один и тот же
        # каталог перечитывался бы столько раз, сколько над ним закладок.
        #
        # Откат на mtime — только когда содержимое не сказало ничего вовсе.
        # Отдать в этом случае ноль значило бы датировать проект 1970 годом:
        # `--dump` считает по этому полю `ago`, а `--state` отдаёт его читателю
        # как `lastActivity`.
        at = project_at(entry["files"], age_of) or entry["files"][0][1]
        for owner in owners_of(entry["cwd"], marks):
            a = agg.setdefault(owner, {"n": 0, "live": 0, "mtime": 0.0})
            a["n"] += len(entry["files"])
            a["live"] += sum(1 for f, _ in entry["files"]
                             if os.path.basename(f)[:-6] in live)
            a["mtime"] = max(a["mtime"], at)

    rows = []
    for path in set(marks) | set(agg):
        a = agg.get(path)
        rows.append({
            "path": path,
            "name": marks.get(path) or os.path.basename(path) or path,
            "mark": path in marks,
            "n": a["n"] if a else 0,
            "live": a["live"] if a else 0,
            "mtime": a["mtime"] if a else 0.0,
            # Считается по `path`, а не по cwd каталога сессий: `owners_of`
            # отдаёт и сам проект, и закладки-предки над ним, и у закладки свой
            # docs/TODO.md — тот, который человек и открывает, придя в неё.
            #
            # Через ту же память, что и строки сессий: у проекта и его сессий
            # каталог общий, и без неё файл читался бы дважды.
            "todo": (todo_at or todo_memo())(path),
        })
    rows.sort(key=lambda r: (-r["mtime"], r["name"].lower()))
    return rows


def merge_project_hotkeys(rows, projects):
    """Приклеить к строкам проектов их хоткеи из файла оконного трекера.

    Единственный источник хоткеев — конфиг windows11-manager: клавиши
    регистрирует читатель (ccfzf-picker), а знать про них ему больше неоткуда.
    Здесь они встречаются со строками, которые собраны из закладок и каталогов
    сессий, — по одному только пути.

    Проекту с хоткеем, у которого нет ни сессий, ни закладки, строка заводится:
    иначе клавиша проекта, в котором давно не работали, пропадала бы из ответа
    ровно тогда, когда она и нужна. Имя такой строке даёт менеджер; у строки,
    которая уже есть, имя не трогается — закладку человек назвал сам.

    Строка без хоткея остаётся без ключа, а не с пустым: у читателя «нет
    клавиши» и «клавиша пустая» — разные вещи.
    """
    # `cwd` здесь перепроверяется, а `hotkey` ниже (`hit["hotkey"]`, `p["hotkey"]`)
    # берётся прямым индексом без своей проверки — это не забытая симметрия.
    # Единственный вызывающий, `read_windows`, уже отдаёт только записи, где
    # оба поля — непустые строки: он выбрасывает молча всё остальное сам
    # (read_windows, разбор `projects`). Проверка `cwd` здесь не о недоверии ко входу, а о его
    # использовании как ключа словаря: не строка или пустая строка ключом не
    # годится. `hotkey` в такой роли не бывает, вторая проверка была бы мёртвым
    # кодом.
    by_path = {}
    for p in projects or []:
        cwd = p.get("cwd")
        if isinstance(cwd, str) and cwd:
            by_path.setdefault(cwd, p)

    out = []
    seen = set()
    for r in rows:
        row = dict(r)
        hit = by_path.get(row["path"])
        if hit:
            row["hotkey"] = hit["hotkey"]
        seen.add(row["path"])
        out.append(row)

    for cwd, p in by_path.items():
        if cwd in seen:
            continue
        out.append({"path": cwd, "name": p.get("name") or os.path.basename(cwd) or cwd,
                    "mark": False, "n": 0, "live": 0, "mtime": 0.0,
                    "hotkey": p["hotkey"]})
    # Синтетические строки дописаны после сортировки project_rows — без
    # пересортировки они всегда падали бы в хвост, даже когда по её же ключу
    # (mtime, потом имя) им место среди других мёртвых закладок наверху.
    out.sort(key=lambda r: (-r["mtime"], r["name"].lower()))
    return out


# Что уезжает в дамп. Читателей у файла два, оба в
# windows11-manager/src/claude-wt/sessions.js (loadSessionIndex,
# loadBackgroundAgents), и это ровно те поля, которые они читают. Остальное —
# gist, doing, file, projects, age, frozen — не читает никто: пикер сюда не
# ходит вовсе, он берёт --state по ssh. Комментарий над режимом dump обещал
# «for whatever else wants to know it»; желающих не нашлось, а платят за
# обещание оба читателя, разбирая и выбрасывая эти байты четырежды в минуту.
DUMP_KEEP = ("id", "title", "cwd", "live", "mtime", "kind", "parent", "activityAt")


def dump_record(s):
    """Запись сессии для дампа.

    Единственное место, где сходятся два писателя одного файла: режимы `dump`
    и `state` пишут его оба, и до этой проекции содержимое зависело от того,
    кто записал последним. Отсутствующее поле роняет KeyError намеренно —
    молча отданный читателю индекс без title стирается целиком.
    """
    return {k: s[k] for k in DUMP_KEEP}


def load_facts(path):
    """Памятка с диска, или пустая — по любой причине.

    Пустая всегда безопасна: памятка — чистая функция от содержимого файлов,
    и промах стоит ровно того, что стоил вызов до её появления.
    """
    if not path:
        return {}
    # `write_json` (ccfzf:1336) разворачивает `~` сама, а сюда путь приходит
    # и как переменная конфига (CCFZF_FACTS_FILE), не только как слово
    # шелла — без развёртки здесь неразвёрнутый `~/...` читался бы как
    # каталог `~` в текущей директории, и памятка тихо всегда была бы пустой.
    path = os.path.expanduser(path)
    try:
        with open(path, encoding="utf-8") as fh:
            o = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(o, dict) or o.get("v") != FACTS_VERSION:
        return {}
    files = o.get("files")
    return files if isinstance(files, dict) else {}


def save_facts(path, facts):
    """Записать памятку. Гонку двух ccfzf решает последний писатель, и это
    верно: у двух памяток об одних и тех же файлах расходиться нечему."""
    if not path:
        return
    # Та же развёртка, что в load_facts, и по той же причине. Плюс голое имя
    # файла без каталога: `os.path.dirname("facts.json")` — пустая строка, а
    # `os.makedirs("")` кидает FileNotFoundError — тоже OSError, тоже тихо
    # выключил бы памятку. Каталог создаём, только когда он вообще указан.
    path = os.path.expanduser(path)
    dirname = os.path.dirname(path)
    if dirname:
        try:
            os.makedirs(dirname, exist_ok=True)
        except OSError:
            return
    write_json(path, {"v": FACTS_VERSION, "files": facts}, indent=None)


def facts_for(path, mtime, cache, tail=None, head=None,
              size_of=os.path.getsize, want_gist=True):
    """Заголовок, последняя реплика и первый промпт — считаются при промахе.

    `gist` живёт по своему правилу: первый промпт сессии неизменен, и
    найденный непустой переносится через любые изменения файла — head_gist для
    неё больше не зовётся никогда, пока файл только дописывают. Пустой
    пересчитывается, пока файл не перерос HEAD_LIMIT: дальше head_gist и сам
    не смотрит, ответ измениться уже не может, и тогда ставится gistDone.

    Допущение «только дописывают» не всегда верно: файл под тем же путём
    иногда подменяют целиком — восстановили из бэкапа, сжали историю, отдали
    id другой сессии. Уменьшение размера — единственная наблюдаемая подпись
    такой подмены, и `size` в памятке хранится ровно ради неё: как только
    текущий размер меньше сохранённого, gist и gistDone сбрасываются и
    пересчитываются заново, как будто памятки для них не было.

    `want_gist=False` — режим `dump`, куда `gist` не уезжает (см. DUMP_KEEP):
    head_gist не зовётся вовсе. Запись, которую в этом случае кладёт промах,
    НЕ несёт ключей `gist`/`gistDone` вовсе — не «искали и не нашли», а «не
    искали». Класть туда `gist: "", gistDone: False` нельзя: `--state` читает
    ту же памятку, и по попаданию mtime ловил бы эту бедную запись как
    полную — простаивающая сессия (а это почти каждая строка списка) молча
    показывала бы человеку последний ответ агента вместо первого промпта
    вечно, потому что mtime у неё больше не сдвинется никогда. Ровно это и
    произошло на сквозной проверке `--state` → `--dump` → `--state`, пока
    отсутствие ключей не стало условием попадания ниже.

    Отсюда и условие попадания на входе: mtime совпал — не значит «можно
    вернуть как есть», если звонящему нужен gist, а запись его не знает.
    Такая запись (mtime свежий, gist ещё не спрошен) — промах наполовину:
    title/doing пересчитывать незачем, они не изменились бы при том же
    mtime, а gist — обязаны.

    Заголовок кладётся уже причёсанным (`clean`): его так читают оба режима, а
    сам `clean` — регулярка, и на двухстах сессиях считается заметно.
    """
    tail = tail or tail_facts
    head = head or head_gist
    old = cache.get(path) or {}
    same_mtime = old.get("mtime") == mtime
    gist_known = "gist" in old and "gistDone" in old

    if same_mtime and (not want_gist or gist_known):
        return old

    if same_mtime:
        title, doing = old.get("title", ""), old.get("doing", "")
        turn_at = old.get("turnAt", 0)
        docs = {}
    else:
        title, doing, turn_at, docs = tail(path)
        title = clean(title)

    try:
        size = size_of(path)
    except OSError:
        size = None

    # `turnAt` живёт в памятке по тому же правилу, что title и doing: считается
    # из того же хвоста и меняется только вместе с файлом, так что ключ mtime
    # для него верен. Отдельным чтением на каждый опрос он стоил бы двухсот
    # хвостов там, где сейчас читаются единицы.
    result = {"mtime": mtime, "title": title, "doing": doing, "turnAt": turn_at}
    if size is not None:
        result["size"] = size

    truncated = (size is not None and old.get("size") is not None
                 and size < old["size"])

    # Счёт реплик человека — единственное поле памятки, которое не
    # пересчитывается, а продолжается: транскрипт только дописывают. Считается
    # он и в режиме `dump`, хотя в сам дамп не уезжает (DUMP_KEEP): памятка у
    # режимов общая, и запись без счёта, положенная дампом, читалась бы
    # `--state` как полная — у простаивающей сессии mtime больше не сдвинется
    # никогда. Ровно эта болезнь уже описана выше у `gist`.
    #
    # Подмену файла счёт не переживает, и подпись та же: размер уменьшился.
    counted_from = 0 if truncated else old.get("countedTo", 0)
    prompts, counted_to = count_prompts(
        path, counted_from, 0 if truncated else old.get("prompts", 0))
    result["prompts"] = prompts
    result["countedTo"] = counted_to

    # Спека и план живут в памятке по тому же правилу, что и `gist`: найденное
    # переносится через изменения файла. Путь, названный однажды и уехавший за
    # TAIL, иначе пропал бы — а сессия над тем же планом и работает.
    #
    # Подмену файла память не переживает, и это та же подпись, по которой
    # сбрасывается `gist`: размер уменьшился — id отдали другой сессии, файл
    # восстановили из бэкапа, историю сжали. Чужой план на новой сессии врал бы
    # молча.
    #
    # Свежая находка старую замещает: сессия за день переходит с плана на план.
    for kind in ("spec", "plan"):
        found = docs.get(kind) or ("" if truncated else old.get(kind, ""))
        if found:
            result[kind] = found

    if not want_gist:
        return result
    gist = "" if (truncated or not gist_known) else (old.get("gist") or "")
    done = bool(gist) or (gist_known and not truncated
                           and bool(old.get("gistDone")))
    if not done:
        gist = head(path)
        if gist:
            # Тот же предел, что у doing (tail_facts, `t[:200]`) и у
            # читателей ответа (`--state`, `f["gist"][:200]`) — хранить
            # длиннее незачем, а памятка целиком перезаписывается на
            # каждый опрос, где у выбранного файла сдвинулся mtime.
            gist = gist[:200]
            done = True
        else:
            done = size is not None and size > HEAD_LIMIT

    result["gist"] = gist
    result["gistDone"] = done
    return result


def write_json(path, obj, indent=1):
    """Atomically, and never at the cost of the run: a dump is a side effect."""
    if not path:
        return
    path = os.path.expanduser(path)
    tmp_path = path + ".%d.tmp" % os.getpid()
    try:
        with open(tmp_path, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, ensure_ascii=False, indent=indent)
        os.replace(tmp_path, path)   # a reader never sees half a list
    except OSError:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass


def stale_dump(path, now, max_age):
    """Пора ли переписать дамп: нет файла, не читается stat, или он старше.

    Судится по mtime, а не по полю `generated` внутри: файл здесь локальный,
    и разбирать двести килобайт json ради одной отметки — раз в секунду, на
    каждый опрос пикера, — стоит дороже самой записи. Врущий mtime, из-за
    которого читатель на Windows открывает файл с правом записи, живёт на той
    стороне SMB и сюда не относится.

    Не удалось узнать возраст — переписываем: лишняя запись стоит меньше, чем
    молча протухший дамп.
    """
    if not path:
        return False
    try:
        return now - os.path.getmtime(os.path.expanduser(path)) > max_age
    except OSError:
        return True


# Пустой режим — не ошибка: так блок выполняют тесты, которым нужны только
# определения. Ни одна ветка ниже на пустую строку не отвечает.
mode = sys.argv[1] if len(sys.argv) > 1 else ""

if mode == "projects":
    marks = read_marks(sys.argv[2])
    index_path = sys.argv[3]
    now = time.time()

    dirs = scan_dirs()
    live, _, _, _ = running_sessions()

    with open(index_path, "w", encoding="utf-8") as fh:
        json.dump({"dirs": [{"cwd": e["cwd"], "files": e["files"]} for e in dirs],
                   "live": sorted(live)}, fh)

    rows = project_rows(dirs, live, marks)

    w = min(max([len(r["name"]) for r in rows] or [0]), 26)
    for r in rows:
        star = GREEN + "★" + RESET if r["mark"] else " "
        n = str(r["n"]) if r["n"] else "-"
        live_col = GREEN + pad(str(r["live"]) + "●", 3) + RESET if r["live"] else "   "
        disp = "%s %s  %s %s %s %s" % (
            star, pad(r["name"], w), pad(n, 4), live_col,
            pad(ago(r["mtime"], now) if r["mtime"] else "", 4),
            DIM + tilde(r["path"]) + RESET,
        )
        print("\t".join([r["path"], r["name"], disp]))

elif mode == "sessions":
    proj = sys.argv[2].rstrip("/")
    preview_dir = sys.argv[3]
    marks = read_marks(sys.argv[4])
    index_path = sys.argv[5]
    now = time.time()

    with open(index_path, encoding="utf-8") as fh:
        index = json.load(fh)
    live = set(index["live"])
    frozen = frozen_ids()

    files = []
    for entry in index["dirs"]:
        if proj in owners_of(entry["cwd"], marks):
            files += [(f, mt, entry["cwd"]) for f, mt in entry["files"]]
    files.sort(key=lambda x: -x[1])

    def write_preview(sid, text):
        with open(os.path.join(preview_dir, sid + ".txt"), "w", encoding="utf-8") as fh:
            fh.write(text)

    # argv[6] — json [[name, key], ...] of the configured project commands
    cmds = json.loads(sys.argv[6]) if len(sys.argv) > 6 else []
    shell_key = sys.argv[7] if len(sys.argv) > 7 else ""
    extras = [("__new__", "[+] new session", "", "New claude session")]
    for i, (cmd_name, cmd_key) in enumerate(cmds, 1):
        extras.append(("__cmd%d__" % i, "[>] " + cmd_name, cmd_key,
                       "%s — in the project directory" % cmd_name))
    extras.append(("__shell__", "[$] shell", shell_key, "Just cd to the project directory"))

    for sid, label, hint, note in extras:
        tail = DIM + "  " + hint + RESET if hint else ""
        print("\t".join([sid, proj, GREEN + label + RESET + tail]))
        write_preview(sid, "%s\n\ncwd: %s\n" % (note, tilde(proj)))

    for path, mtime, cwd in files:
        sid = os.path.basename(path)[:-6]
        name, doing = tail_facts(path)
        name = clean(name)
        gist = head_gist(path) or doing
        age = ago(mtime, now)

        if name and gist:
            label = CYAN + name + RESET + DIM + " · " + gist + RESET
        else:
            label = CYAN + name + RESET if name else (gist or DIM + "(empty)" + RESET)
        dot = GREEN + "●" + RESET if sid in live else " "
        star = YELLOW + "*" + RESET if sid in frozen else " "
        usage = usage_text(sid)
        print("\t".join([sid, cwd, "%s%s %s %s %s" % (
            dot, star, DIM + pad(age, 4) + RESET, DIM + usage + RESET, label)]))

        write_preview(sid, "".join([
            (name + "\n") if name else "",
            "%s%s\n" % (tilde(cwd), "   [running]" if sid in live else ""),
            "%s  ·  %s  ·  %s\n\n" % (sid, age, usage.strip() or "no usage data"),
            (gist or "(no first message)") + "\n",
            ("\n▸ " + doing + "\n") if doing and doing != gist else "",
        ]))

    print(len(files), file=sys.stderr)

elif mode == "dump":
    # Каждый проект и `limit` (argv[6]) новейших сессий по всем проектам —
    # DUMP_SESSIONS тут лишь запасное значение на случай, если argv пуст.
    # Читателей у результата два, и «for whatever else wants to know it» уже
    # тогда было неправдой — см. обоснование у DUMP_KEEP. Хвостов запрошено
    # сто, но большинство читать не приходится: попадание в памятку фактов
    # (load_facts/save_facts) экономит разбор всем, у кого не сдвинулся mtime.
    marks = read_marks(sys.argv[2])
    sessions_path = sys.argv[3] if len(sys.argv) > 3 else ""
    projects_path = sys.argv[4] if len(sys.argv) > 4 else ""
    windows_path = sys.argv[5] if len(sys.argv) > 5 else ""
    limit = int(sys.argv[6]) if len(sys.argv) > 6 and sys.argv[6] else DUMP_SESSIONS
    now = time.time()

    dirs = scan_dirs()
    live, agents, _, _ = running_sessions()
    # Отметки хуков — те самые, за mtime которых читатель дампа сегодня ходит
    # по сети на каждого кандидата с общим заголовком. Здесь файлы локальные и
    # обход один: scandir по каталогу, доли миллисекунды. Считать одно и то же
    # с двух сторон незачем — число уезжает полем.
    stamps = hook_stamps()
    windows, _, _, _, _, _ = read_window_sources(
        windows_path, sys.argv[7] if len(sys.argv) > 7 else "", now)
    # То же объединение, что в режиме `state`, и по той же причине — плюс одна
    # своя: `$SESSIONS_FILE` пишут оба режима, и без этой строки значение `live`
    # в общем файле зависело бы от того, кто записал последним. Про сам зачёт
    # окна в живые, и про кольцо с трекером, читать там.
    live |= set(windows)

    if projects_path:
        write_json(projects_path, {
            "generated": now,
            "projects": [{
                "path": r["path"], "name": r["name"], "mark": r["mark"],
                "sessions": r["n"], "live": r["live"], "mtime": r["mtime"],
                "age": ago(r["mtime"], now) if r["mtime"] else "",
            } for r in project_rows(dirs, live, marks)],
        })

    if sessions_path:
        files = []
        for entry in dirs:
            files += [(f, mt, entry["cwd"]) for f, mt in entry["files"]]
        files.sort(key=lambda x: -x[1])
        total = len(files)

        # `live` здесь уже вобрал сессии с открытым окном (`live |= set(windows)`
        # выше), так что второго множества не нужно.
        picked = pick_files(files, limit, live)

        cache = load_facts(FACTS_FILE)
        facts = {}
        sessions = []
        for path, mtime, cwd in picked:
            sid = sid_of(path)
            # head_gist здесь не зовётся: `gist` в дамп не уезжает, а стоил
            # он 165 мс из 320 на двухстах сессиях.
            f = facts_for(path, mtime, cache, want_gist=False)
            facts[path] = f
            agent = agents.get(sid) or {}
            sessions.append(dump_record({
                "id": sid, "cwd": cwd, "title": f["title"],
                "mtime": mtime, "live": sid in live,
                "kind": agent.get("kind", "interactive"),
                "parent": agent.get("parent", ""),
                "activityAt": int(stamps.get(sid, 0)),
            }))
        if facts != cache:
            save_facts(FACTS_FILE, facts)

        write_json(sessions_path, {
            "generated": now, "total": total, "shown": len(sessions),
            "sessions": sessions,
        })

elif mode == "state":
    # Всё, что нужно удалённому пикеру, одним JSON в stdout. Форма намеренно
    # сырая — kind, parent и agent уходят как есть, а склейку «кто на самом
    # деле работает» делает читатель.
    #
    # Дамп сессий при этом переписывается по дороге, но только протухший — см.
    # STATE_DUMP_MAX_AGE. Читатель дампа сидит на другой машине, к нему этот
    # ответ отношения не имеет, и обновлять дамп больше некому: пикер, который
    # раньше это делал, заменён на того, кто зовёт --state.
    marks = read_marks(sys.argv[2])
    sessions_path = sys.argv[4] if len(sys.argv) > 4 else ""
    limit = int(sys.argv[5]) if len(sys.argv) > 5 and sys.argv[5] else DUMP_SESSIONS
    comments = read_comments(sys.argv[7] if len(sys.argv) > 7 else "")
    # Одна память на весь ответ: счёт спрашивают и строки проектов, и строки
    # сессий, а каталоги у них те же самые.
    todo_at = todo_memo()
    now = time.time()

    dirs = scan_dirs()
    live, agents, procs, zellij_rows = running_sessions()
    # Отметки хуков — те самые, за mtime которых читатель дампа сегодня ходит
    # по сети на каждого кандидата с общим заголовком. Здесь файлы локальные и
    # обход один: scandir по каталогу, доли миллисекунды. Считать одно и то же
    # с двух сторон незачем — число уезжает полем.
    stamps = hook_stamps()
    frozen = frozen_ids()
    # Необязательная добавка: у какой сессии открыто окно терминала. Знать это
    # отсюда неоткуда — здесь видны процессы, а не окна, и окна вообще на другой
    # машине. Их владелец кладёт файл рядом, и дальше это просто ещё одно поле.
    windows, window_host, window_pid, window_snapshots, window_projects, window_hosts = \
        read_window_sources(sys.argv[3] if len(sys.argv) > 3 else "",
                            sys.argv[6] if len(sys.argv) > 6 else "", now)
    # Открытое окно — наблюдение, а не догадка по транскрипту, и оно перебивает
    # fresh_ids с её двухчасовой отсечкой: сессия, которой полдня не писали, но
    # чей терминал открыт на экране, жива. Протухший файл трекера read_windows
    # уже отбросил сама (WINDOWS_TTL), так что умерший демон никого не оживит
    # навечно; а на машине без трекера windows пуст, и здесь ничего не меняется.
    #
    # Два следствия, которых отсюда не видно, потому что вторая их половина
    # лежит в соседнем репозитории.
    #
    # Первое — обратная связь. Трекер (windows11-manager, compareSessions) при
    # двух окнах с одинаковым заголовком выбирает кандидата в том числе по
    # `live`, а `live` теперь отчасти приходит из его же файла. Промахнувшись
    # раз, он подтверждает промах сам себе, и тот перестаёт рассасываться.
    # Спасает то, что активность хука в том сравнении весит больше `live`, —
    # но это смягчение, а не развязка.
    #
    # Второе — reattribute. Она снимает id, который сессия сменила на ходу
    # (`live.discard`), а объединение вернёт его обратно, пока трекер держит
    # старую привязку: его вид дампа отстаёт секунд на тридцать. Расхождение
    # проходит само, но оно ровно того рода, против которого reattribute и
    # заведена.
    live |= set(windows)

    files = []
    for entry in dirs:
        files += [(f, mt, entry["cwd"]) for f, mt in entry["files"]]
    files.sort(key=lambda x: -x[1])

    # `live` здесь уже вобрал сессии с открытым окном (`live |= set(windows)`
    # выше), так что второго множества не нужно.
    picked = pick_files(files, limit, live)

    cache = load_facts(FACTS_FILE)
    facts = {}
    sessions = []
    for path, mtime, cwd in picked:
        sid = sid_of(path)
        f = facts_for(path, mtime, cache)
        facts[path] = f
        agent = agents.get(sid) or {}
        wins = windows.get(sid)
        sessions.append({
            "id": sid, "cwd": cwd, "file": path,
            "projects": sorted(owners_of(cwd, marks)),
            # Спека и план — пути внутри `cwd`, а не абсолютные: файл лежит на
            # этой машине, а открывает его читатель у себя, переведя путь через
            # свой pathMap. Абсолютный путь той стороне пришлось бы разбирать
            # обратно.
            #
            # Ключей нет, когда бумаг нет, — а нет их у трёх сессий из четырёх.
            # Пустая строка в ответе на каждую строку списка стоила бы места
            # ради того же, что значит отсутствие ключа.
            **({"spec": f["spec"]} if f.get("spec") else {}),
            **({"plan": f["plan"]} if f.get("plan") else {}),
            # Размер сессии — число реплик человека. Отвечает на то, на что не
            # отвечает `contextPct`: тот говорит, сколько осталось до сжатия, и
            # после /compact падает. Ключ ставится всегда, даже нулём: ноль
            # здесь честен — сессия, в которой человек ещё ничего не написал,
            # бывает.
            "prompts": f.get("prompts", 0),
            # Счётчики docs/TODO.md каталога сессии. Те же, что у строки её
            # проекта: файл один, и второй счёт рядом с первым был бы поводом
            # не верить обоим.
            **({"todo": todo_at(cwd)} if todo_at(cwd) else {}),
            # Комментарий человека — общий на все машины: файл лежит здесь, а
            # `--state` читают все пикеры. Ключа нет, когда комментария нет.
            **({"comment": comments[sid]["text"]} if sid in comments else {}),
            "title": f["title"], "gist": (f["gist"] or f["doing"])[:200],
            "doing": f["doing"],
            "mtime": mtime, "age": ago(mtime, now),
            "live": sid in live, "frozen": sid in frozen,
            "activityAt": int(stamps.get(sid, 0)),
            "kind": agent.get("kind", "interactive"),
            "parent": agent.get("parent", ""),
            "pid": (procs.get(sid) or {}).get("pid", 0),
            "tty": (procs.get(sid) or {}).get("tty", ""),
            "tmux": (procs.get(sid) or {}).get("tmux"),
            "zellij": (procs.get(sid) or {}).get("zellij"),
            "agent": agent_of(sid, path, f.get("turnAt", 0)),
            # Отсутствует, а не null: «окна нет» и «про окна ничего не известно»
            # у читателя рисуются одинаково, и заводить между ними разницу
            # некому — она не видна ни в одной строке списка.
            #
            # Полей два, и второе не дубль. `windows` — все окна сессии: её
            # открывают и на двух машинах сразу. `window` — первое из них, и
            # живёт оно ради читателя прошлой версии: пикер и агрегатор
            # выкатываются порознь, порядок нам не подвластен.
            "window": wins[0] if wins else None,
            "windows": wins,
        })

    # Записи файлов, выпавших из среза, в памятку не попали — чистка выходит
    # сама. Пишем только при отличии: иначе каждый опрос пикера стоил бы
    # записи всей памятки на диск.
    if facts != cache:
        save_facts(FACTS_FILE, facts)

    # Дамп — подмножество того же списка, собранное здесь проекцией, а не
    # вторым проходом. Не «тот же срез DUMP_SESSIONS» — у режима `dump` свой
    # `limit` из своего argv, он может отличаться от этого. И не «расход уже
    # оплачен выше» — читать двести хвостов не пришлось и здесь: памятка
    # фактов (load_facts/save_facts) отдаёт большинство из кеша по mtime.
    # Лишние поля (pid, tty, tmux, agent, window) читателю дампа не нужны:
    # процессы он видит свои, а окна сам сюда и кладёт. Список полей и
    # обоснование — у DUMP_KEEP.
    if stale_dump(sessions_path, now, STATE_DUMP_MAX_AGE):
        write_json(sessions_path, {
            "generated": now, "total": len(files), "shown": len(sessions),
            "sessions": [dump_record(s) for s in sessions],
        })

    # Чья это машина и какому процессу принадлежат окна. Первое отвечает
    # читателю, стоит ли вообще поднимать окно: на чужом экране это бессмысленно.
    # Второе нужно, чтобы выдать тому процессу право на передний план — Windows
    # отдаёт его только владельцу или тому, кто получил последнее событие ввода.
    # Проекты — то, что видит режим `projects`, плюс синтетические строки от
    # merge_project_hotkeys: проекту с хоткеем, у которого нет ни сессий, ни
    # закладки, режим `projects` строку не покажет вовсе, а здесь она нужна —
    # иначе клавиша пропадала бы из ответа ровно тогда, когда она и нужна.
    # Читателю проекты нужны, чтобы начать новую сессию там, где сессий ещё не
    # было: по cwd приехавших сессий такой проект не восстановить, он приходит
    # из marks (или из хоткея).
    #
    # Даром: dirs и live уже собраны выше, project_rows — арифметика над ними.
    # `age` не отдаётся намеренно: возраст в строке считает читатель, и вторая
    # его форма разошлась бы с колонкой при первом же расхождении форматов.
    # Считая его, про ноль в `mtime` надо помнить: у проекта, который есть в
    # marks, но сессий в нём не было, датировать нечем — на этой машине таких
    # 6 из 46, и они-то и есть причина отдавать список проектов отдельно.
    # Формат «сколько назад» по нулю нарисует 1970 год. Режим `dump` этот же
    # ноль сторожит явно: `"age": ago(...) if r["mtime"] else ""`.
    json.dump({"generated": now, "sessions": sessions,
               # `todo` уезжает только пустым-непустым: у двадцати проектов из
               # сорока пяти docs/TODO.md нет вовсе, и ключ с пустым списком
               # стоил бы места в ответе ради «считать нечего» — того же, что
               # значит его отсутствие. В `dump` поля нет намеренно: панель и
               # экспорт в HA про задачи не спрашивают, а разбор файла на их
               # стороне был бы вторым счётом рядом со статуслайном.
               "projects": [{"path": r["path"], "name": r["name"], "mark": r["mark"],
                             "sessions": r["n"], "live": r["live"], "mtime": r["mtime"],
                             **({"todo": r["todo"]} if r.get("todo") else {}),
                             **({"hotkey": r["hotkey"]} if r.get("hotkey") else {})}
                            for r in merge_project_hotkeys(
                                project_rows(dirs, live, marks, todo_at=todo_at),
                                window_projects)],
               "windowHost": window_host, "windowPid": window_pid,
               # Живые трекеры поимённо. Пикеру нужно отличать «моей машины
               # среди трекеров нет» от «есть, но окон у неё сейчас нет»: по
               # списку окон этого не понять, у здорового трекера без открытых
               # терминалов он пуст.
               "windowHosts": window_hosts,
               # Раскладки, которые помнит трекер. Оттуда же, откуда окна:
               # здесь видны процессы, а окна — на другой машине.
               "snapshots": window_snapshots,
               # Открытые зелийные сессии, все до одной. Не только те, внутри
               # которых агента нет: список сессий обрезан (`--limit`), агент
               # может в срез не попасть, и тогда пропала бы и его строка, и
               # строка его зелийной сессии — ровно та невидимость, ради
               # которой всё делается.
               "zellij": zellij_rows},
              sys.stdout, ensure_ascii=False)

elif mode == "comment":
    # Запись комментария. Текст приходит на **stdin**, а не аргументом, и это
    # не удобство: `ssh host cmd args…` склеивает аргументы в одну строку,
    # которую заново разбирает удалённый шелл, — то есть комментарий вида
    # `fix; rm -rf ~` был бы командой. Через stdin текст шелла не касается
    # вовсе. Id при этом аргумент, и это безопасно: он UUID и проверяется по
    # алфавиту в set_comment.
    #
    # Имя машины, назвавшей комментарий, приезжает вторым аргументом: сама она
    # тут не угадывается — ssh приходит с любой из них, а $HOSTNAME назвал бы
    # эту.
    # Текст — из окружения, а не из stdin: stdin у этого процесса занят самим
    # блоком (bash кормит им python), и читать оттуда нечего. Шелла на пути
    # переменной нет вовсе, поэтому кавычить её не нужно и нечем.
    ok = set_comment(sys.argv[3], sys.argv[2],
                     os.environ.get("CCFZF_COMMENT_TEXT", ""), time.time(),
                     sys.argv[4] if len(sys.argv) > 4 else "")
    if not ok:
        sys.stderr.write("ccfzf: not a session id\n")
        sys.exit(2)

elif mode == "newname":
    # Занятыми считаются заголовки живых сессий: имя сессии — это заголовок её
    # окна, по нему оконный трекер привязывает сессию к слоту, и мешают друг
    # другу именно живые тёзки. Мёртвая сессия с тем же именем не мешает
    # никому. Живых немного, и чтение их хвостов ничего не стоит рядом с двумя
    # сотнями в дампе.
    index_path = sys.argv[2]
    base = sys.argv[3]

    with open(index_path, encoding="utf-8") as fh:
        index = json.load(fh)
    live = set(index["live"])

    taken = set()
    for entry in index["dirs"]:
        for path, _mtime in entry["files"]:
            sid = os.path.basename(path)[:-6]
            if sid not in live:
                continue
            title = clean(tail_facts(path)[0])
            if title:
                taken.add(title.strip())

    print(free_session_name(base, taken))
PYEOF

# Блок уходит питону на stdin, а не аргументом `python3 -c`. Причина — жёсткий
# потолок ядра: MAX_ARG_STRLEN, 32 страницы, то есть 128 КБ на ОДИН аргумент,
# сколько бы места ни было под argv целиком. Блок дорос до него и перешагнул,
# и отказ вышел непроходимый и без подсказки о причине: `Argument list too
# long`, код 126, ни одного ответа --state. У stdin такого потолка нет вовсе.
#
# Не файл во временном каталоге: `$tmp` заводит только интерактивная ветка, а
# `--state` намеренно обходится без `mktemp` — его зовут по ssh раз в секунду.
# Своего stdin ни один режим не читает, так что занять его нечем.
py() { printf '%s\n' "$PY" | python3 - "$@"; }

# Комментарий пишется до всего остального: список для этого не нужен вовсе, а
# ходит сюда пикер по ssh отдельным вызовом.
#
# Текст приезжает на stdin, а не аргументом: `ssh host cmd args…` склеивает
# аргументы в строку, которую заново разбирает удалённый шелл, — комментарий с
# `;` был бы командой. Дальше он идёт питону переменной окружения, и это не
# каприз: stdin у python уже занят самим блоком (см. py() выше), а переменная
# уходит в execve как есть — её не разбирает ни один шелл. Двухсот знаков
# предела ей хватает с запасом.
if [[ -n $comment_id ]]; then
  [[ -n $COMMENTS_FILE ]] || { echo "ccfzf: comments file is off" >&2; exit 2; }
  CCFZF_COMMENT_TEXT=$(cat) py comment "$comment_id" "$COMMENTS_FILE" "$comment_host"
  exit $?
fi

# External callers (the picker) need the dumps rewritten without opening
# the interactive UI. Run in the foreground so ssh returns only after the rename.
if ((dump_only)); then
  [[ -n $SESSIONS_FILE || -n $PROJECTS_FILE ]] || exit 0
  py dump "$MARKS" "$SESSIONS_FILE" "$PROJECTS_FILE" "$WINDOWS_FILE" "$limit" "$WINDOWS_DIR"
  exit 0
fi

# Читателю на другой машине нужен ответ в stdout, а не файл на диске.
if ((state_only)); then
  py state "$MARKS" "$WINDOWS_FILE" "$SESSIONS_FILE" "$limit" "$WINDOWS_DIR" "$COMMENTS_FILE"
  exit 0
fi

index="$tmp/index.json"
rows=$(py projects "$MARKS" "$index")
[[ -n $rows ]] || { echo "ccfzf: no marks and no sessions found" >&2; exit 1; }

# Border, height and layout are left to FZF_DEFAULT_OPTS.
fzf_pick() { # <query> ; rows on stdin
  fzf --ansi --delimiter=$'\t' --with-nth=3 --no-multi --query="$1" "${@:2}"
}

# json [[name, key], ...] and the --expect list, both from configured commands
cmd_json="["
expect="$shell_key"
for i in 0 1 2; do
  [[ -n ${cmd_list[i]} ]] || continue
  [[ $cmd_json == "[" ]] || cmd_json+=","
  cmd_json+=$(printf '["%s","%s"]' "${cmd_names[i]//\"/}" "${cmd_keys[i]}")
  expect+=",${cmd_keys[i]}"
done
cmd_json+="]"

build_srows() {
  srows=$(py sessions "$proj_path" "$tmp" "$MARKS" "$index" \
    "$cmd_json" "$shell_key" 2>"$tmp/count")
  shown=$(cat "$tmp/count" 2>/dev/null || echo 0)
}

# The dump covers every project, so it has nothing to do with what is on screen
# and runs detached: its `--limit` file tails cost more than the picker itself,
# and nothing here waits for them. Its own scan keeps it independent of $tmp,
# which the exit trap takes away the moment the user picks something.
dump_state() {
  [[ -n $SESSIONS_FILE || -n $PROJECTS_FILE ]] || return 0
  py dump "$MARKS" "$SESSIONS_FILE" "$PROJECTS_FILE" "$WINDOWS_FILE" "$limit" "$WINDOWS_DIR" \
    >/dev/null 2>&1 &
}

row_index() { awk -F'\t' -v p="$1" '$1 == p { print NR; exit }' <<<"$all_rows"; }

# A command is started through an *interactive* shell, and the cd into the
# project happens inside it. `$SHELL -c` reads no rc file (zsh takes only
# .zshenv), so hooks and exports set up in .zshrc never ran for the command:
# claude inherited whatever the shell that launched ccfzf had — the previous
# project's OTEL_RESOURCE_ATTRIBUTES, for instance. Doing the cd after the rc
# file is read fires chpwd hooks for the picked directory, and an rc that cd's
# on its own (SSH_STARTDIR and the like) can no longer steal the directory back.
in_dir() { printf 'cd -- %q && %s' "$1" "$2"; }

# The picker labels the terminal itself. Whatever ran before it — claude above
# all — leaves its own title behind, so in kiosk mode a window sitting in the
# session list looked exactly like the session it had just left. Everything
# started from here sets its own title afterwards, and the prompt gets its title
# back from the shell, so this only ever holds while a picker is on screen.
# Written to the tty: with --print stdout is the command itself.
set_title() {
  [[ -w /dev/tty ]] || return 0
  printf '\033]0;%s\007' "$1" >/dev/tty 2>/dev/null || true
}

dump_state

all_rows=$rows
picked=""
query=$project
posbind=""

# --- direct entry into a session by id --------------------------------------
# Called by external automation (claude-wt restore), so a missing session is an
# error, not a reason to drop into the picker: that would hang the caller.
if [[ -n $session_id ]]; then
  sess_file=$(ls -1 "$HOME"/.claude/projects/*/"$session_id".jsonl 2>/dev/null | head -1 || true)
  [[ -n $sess_file ]] || { echo "ccfzf: session $session_id not found" >&2; exit 1; }
  # cwd is not reliably on line 1 — recent transcripts open with a run of meta
  # records (mode, last-prompt, permission-mode, hook attachments) before the
  # first line that carries it. Same idiom as dir_cwd() above: scan up to 50
  # lines, skip ones that fail to parse, take the first cwd found.
  dir=$(python3 -c 'import json,sys
try:
    with open(sys.argv[1], "rb") as f:
        for _ in range(50):
            line = f.readline()
            if not line:
                break
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("cwd"):
                print(o["cwd"].rstrip("/"))
                break
except OSError:
    pass' "$sess_file")
  [[ -n $dir && -d $dir ]] || { echo "ccfzf: session $session_id has no usable cwd" >&2; exit 1; }
  cmd="$CLAUDE_CMD --resume $(printf '%q' "$session_id")$claude_tail"
  cmd=${cmd% }
  if ((kiosk)); then
    (cd "$dir" && exec "$SHELL" -ic "$(in_dir "$dir" "$cmd")") || true
    rows=$(py projects "$MARKS" "$index")
    all_rows=$rows
    dump_state
    picked=$(awk -F'\t' -v p="$dir" '$1 == p { print; exit }' <<<"$rows")
    [[ -n $picked ]] || picked=$(printf '%s\t%s\t%s' "$dir" "$(basename "$dir")" "$dir")
    query=""
    posbind=""
  elif ((print_mode)); then
    printf 'cd %q && %s\n' "$dir" "$cmd"
    exit 0
  else
    cd "$dir"
    exec "$SHELL" -ic "$(in_dir "$dir" "$cmd")"
  fi
fi

# --- resolve the project argument ------------------------------------------
if [[ -n $project ]]; then
  picked=$(awk -F'\t' -v q="$project" '$2 == q { print; exit }' <<<"$rows")

  if [[ -z $picked && -d $project ]]; then
    dir=$(cd "$project" && pwd -P)   # not realpath: stock macOS has none
    picked=$(awk -F'\t' -v q="$dir" '$1 == q { print; exit }' <<<"$rows")
    [[ -n $picked ]] || picked=$(printf '%s\t%s\t%s' "$dir" "$(basename "$dir")" "$dir")
  fi

  if [[ -z $picked ]]; then
    subset=$(awk -F'\t' -v q="$project" \
      'BEGIN { q = tolower(q) } index(tolower($1), q) || index(tolower($2), q)' <<<"$rows")
    if [[ $(grep -c . <<<"$subset") -eq 1 && -n $subset ]]; then
      picked=$subset
    else
      [[ -n $subset ]] && rows=$subset
    fi
  fi
fi

# --- project → session; esc in sessions goes back to the project list ------
while :; do
  if [[ -z $picked ]]; then
    set_title "ccfzf project select"
    pick_args=(--header=$'project           sess live last\nenter — sessions, esc — quit')
    [[ -n $posbind ]] && pick_args+=(--bind="$posbind")
    picked=$(fzf_pick "$query" "${pick_args[@]}" <<<"$rows") || exit $?
  fi

  proj_path=${picked%%$'\t'*}
  rest=${picked#*$'\t'}
  proj_name=${rest%%$'\t'*}

  build_srows

  # Coming back from a kiosk run: put the cursor where the user left off.
  sess_args=()
  if [[ -n ${kiosk_used:-} ]]; then
    target=$kiosk_used
    if [[ $kiosk_used == "__new__" ]]; then
      # the fresh session got an id of its own — aim at it, not at [+] new
      fresh=$(grep -vxF -f <(printf '%s\n' "$kiosk_prev") <(cut -f1 <<<"$srows") | head -1 || true)
      [[ -n $fresh ]] && target=$fresh
    fi
    n=$(awk -F'\t' -v s="$target" '$1 == s { print NR; exit }' <<<"$srows")
    [[ -n $n ]] && sess_args+=(--bind="load:pos($n)")
    kiosk_used=""
  fi

  # Terminals grab Ctrl+S as XOFF, so flow control is switched off for the
  # duration of the picker and the previous mode is restored right after.
  # 2>/dev/null must precede </dev/tty: otherwise bash itself reports the
  # failed redirection and there is nothing left to silence it with.
  stty_save=$(stty -g 2>/dev/null </dev/tty || true)
  [[ -n $stty_save ]] && stty -ixon 2>/dev/null </dev/tty || true
  hints="enter — run"
  for i in 0 1 2; do
    [[ -n ${cmd_list[i]} ]] && hints+=", ${cmd_keys[i]} — ${cmd_names[i]}"
  done
  hints+=", $shell_key — shell, esc — back"
  set_title "ccfzf session select"
  set +e
  out=$(fzf_pick "" --expect="$expect" "${sess_args[@]+"${sess_args[@]}"}" \
    --header="$proj_name · sessions: $shown"$'\n'"$hints" \
    --preview="cat $tmp/{1}.txt" --preview-window="down,5,wrap,border-top" <<<"$srows")
  code=$?
  set -e
  [[ -n $stty_save ]] && stty "$stty_save" 2>/dev/null </dev/tty || true

  if ((code != 0)); then
    ((code == 130 || code == 1)) || exit $code   # 130/1 — esc, anything else is an error
    # back: full list, no query, cursor on the project we just left
    idx=$(row_index "$proj_path")
    rows=$all_rows
    query=""
    picked=""
    posbind=""
    [[ -n $idx ]] && posbind="load:pos($idx)"
    continue
  fi

  key=$(head -1 <<<"$out")
  sel=$(tail -n +2 <<<"$out")
  sid=${sel%%$'\t'*}
  rest=${sel#*$'\t'}
  dir=${rest%%$'\t'*}

  # the hotkey outranks the highlighted row, but the directory comes from it
  if [[ $key == "$shell_key" ]]; then
    sid="__shell__"
  else
    for i in 0 1 2; do
      [[ -n ${cmd_list[i]} && $key == "${cmd_keys[i]}" ]] && sid="__cmd$((i + 1))__"
    done
  fi

  # cmd is a ready-made shell string: a project command may carry arguments
  cmd=""
  case "$sid" in
    __shell__) : ;;                          # cd is enough, no nested shell needed
    __cmd1__)  cmd=${cmd_list[0]} ;;
    __cmd2__)  cmd=${cmd_list[1]} ;;
    __cmd3__)  cmd=${cmd_list[2]} ;;
    # Name the session after the project folder so WT titles and the
    # project hotkeys can find it without waiting for /rename.
    #
    # Живая тёзка получает суффикс: два окна с одинаковым заголовком оконный
    # трекер путает между собой. Отказ python3 не должен отнимать новую
    # сессию — тогда имя остаётся прежним, как было до суффиксов.
    __new__)
      new_name=$(py newname "$index" "$(basename "$dir")" 2>/dev/null)
      [[ -n $new_name ]] || new_name=$(basename "$dir")
      cmd="$CLAUDE_CMD -n $(printf '%q' "$new_name")$claude_tail" ;;
    *)         cmd="$CLAUDE_CMD --resume $(printf '%q' "$sid")$claude_tail" ;;
  esac
  cmd=${cmd% }

  ((kiosk)) || break

  # Kiosk: run as a child instead of exec'ing, then land back in this
  # project's session list. Sessions changed under us, so the index is
  # rebuilt — it costs about as much as one fzf redraw.
  kiosk_prev=$(cut -f1 <<<"$srows")
  kiosk_used=$sid
  if [[ -n $cmd ]]; then
    (cd "$dir" && exec "$SHELL" -ic "$(in_dir "$dir" "$cmd")") || true
  else
    (cd "$dir" && exec "$SHELL") || true
  fi
  rows=$(py projects "$MARKS" "$index")
  all_rows=$rows
  dump_state                                  # sessions changed under us
  picked=$(awk -F'\t' -v p="$proj_path" '$1 == p { print; exit }' <<<"$rows")
  [[ -n $picked ]] || picked=$(printf '%s\t%s\t%s' "$proj_path" "$proj_name" "$proj_path")
  query=""
  posbind=""
done

# --- launch ----------------------------------------------------------------
if ((print_mode)); then
  if [[ -z $cmd ]]; then
    printf 'cd %q\n' "$dir"
  else
    printf 'cd %q && %s\n' "$dir" "$cmd"
  fi
else
  cd "$dir"
  # without the widget the parent directory cannot be changed, so run a shell
  [[ -n $cmd ]] && exec "$SHELL" -ic "$(in_dir "$dir" "$cmd")"
  exec "$SHELL"
fi
