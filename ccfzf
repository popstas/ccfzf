# его транскрипта уже читается ради заголовка.
#
# Дорог у спеки две, у плана одна, и асимметрия эта не оплошность.
# `docs/superpowers/specs/` и короткий `docs/specs/` — один и тот же каталог
# спек, просто разных лет: у windows11-manager рядом лежат оба, и новейшая
# спека как раз в коротком. А `docs/plans/` без `superpowers/` — планы
# ralphex: они живут по другому правилу и открываются иначе, и поймай их
# регулярка, пункт меню обещал бы человеку не то, куда ведёт.
#
# Поймано на живой сессии 9974: путь `docs/specs/…-claude-place-layouts-…`
# назван в хвосте транскрипта двадцать семь раз, а колонка бумаги пуста —
# отказ здесь молчащий, отличить «спеки нет» от «спеку не узнали» нечем.
#
# Алфавит имени узкий намеренно: путь уезжает дальше в argv команды открытия,
# а `[^/]+` пропустил бы туда пробел, кавычку и перевод строки.
DOC_RE = re.compile(rb"docs/superpowers/(specs|plans)/[0-9A-Za-z._-]+\.md"
                    rb"|docs/(specs)/[0-9A-Za-z._-]+\.md")
DOC_KINDS = {b"specs": "spec", b"plans": "plan"}
DUMP_SESSIONS = 100       # умолчание для --limit: сколько новейших сессий смотрим
# Возраст, после которого файл окон считается брошенным. Оконный трекер живёт
# на другой машине и переписывает файл не реже раза в полминуты; молчание
# дольше этого значит, что машину выключили или демон умер, а не что расклад
# застыл. Без срока годности пометки об окнах пережили бы и то, и другое.
WINDOWS_TTL = 120
# Насколько старым должен стать дамп сессий, чтобы --state переписал его по
# дороге. Дамп читает оконный трекер на другой машине, и до появления пикера с
