FRESH_MAX_AGE = 2 * 3600

DIM, GREEN, YELLOW, CYAN, RESET = "\033[2m", "\033[32m", "\033[33m", "\033[36m", "\033[0m"


def mangle(path):
    return re.sub(r"[^a-zA-Z0-9]", "-", path)


def tilde(p):
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def pad(s, w):
    return s + " " * max(0, w - len(s))


def clean(s):
    return re.sub(r"\s+", " ", (s or "")).strip()


def ago(t, now):
    s = max(0, now - t)
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 86400:
        return "%dh" % (s // 3600)
    return "%dd" % (s // 86400)


def read_marks(marks_file):
    marks = {}
    if os.path.exists(marks_file):
        with open(marks_file, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if " : " not in line:
                    continue
                name, path = line.rstrip("\n").split(" : ", 1)
                path = os.path.expanduser(path.strip()).rstrip("/")
                if path:
                    marks[path] = name.strip()
    return marks


def owners_of(cwd, marks):
    """Projects whose session list should show a session from this cwd.

    Its own cwd always. Plus the nearest ancestor mark when the cwd is not a
    mark itself: marks are declared project roots, so a session started in a
    subdirectory (config subrepo, worktree) belongs in the root's list too.
    Without the marks-only restriction a mark on ~ would swallow every project.
    """
    owners = {cwd}
    if cwd not in marks:
        ancestors = [m for m in marks if cwd.startswith(m + "/")]
        if ancestors:
            owners.add(max(ancestors, key=len))
    return owners


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
    return ""


def noisy(t):
    return (t.startswith("<") or t.startswith("Base directory for this skill")
            or t.startswith("Caveat:") or "<command-" in t[:40])


def dir_cwd(files):
    """Project cwd — from the first lines of the newest file in the directory."""
    for path in files[:3]:
        try:
            with open(path, "rb") as fh:
                for _ in range(50):
                    line = fh.readline()
                    if not line:
                        break
                    try:
                        o = json.loads(line)
                    except Exception:
                        continue
                    if o.get("cwd"):
                        return o["cwd"].rstrip("/")
        except OSError:
            continue
    return ""


def sid_of(path):
    """Id сессии по имени её транскрипта."""
    return os.path.basename(path)[:-6]


def pick_files(files, limit, keep_ids):
    """Первые `limit` по свежести плюс те, кого терять нельзя.

    `files` отсортирован по убыванию mtime, поэтому добавка всегда старше
    головы и порядок сохраняется сам — пересортировывать нечего.

    Объединение — не перестраховка. Один срез по времени отрезал бы сессию,
    чей транскрипт не трогали дольше среза, а окно её открыто до сих пор: у
    читателя дампа она единственный способ понять, чьё это окно. Фильтровать
    вместо этого по `live` нельзя — флаг уже врал (2026-08-01, работающая
    сессия с `live: false`), а объединение только добавляет и потому соврать
    не может.
    """
    head = files[:limit]
    if len(files) <= limit or not keep_ids:
        return head
    return head + [f for f in files[limit:] if sid_of(f[0]) in keep_ids]


def head_gist(path):
    """The first meaningful user prompt."""
    read = 0
    try:
        with open(path, "rb") as fh:
            for line in fh:
                read += len(line)
                if read > HEAD_LIMIT:
                    break
                if b'"user"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("type") == "user" and (o.get("message") or {}).get("role") == "user":
                    t = clean(text_of(o["message"].get("content")))
                    if t and not noisy(t):
                        return t
    except OSError:
        pass
    return ""


def num(v):
    """Положительное число или 0.

    Файлы состояния пишут хуки, и одно испорченное поле не должно ронять разбор
    всех сессий: сравнение или max() со строкой поднимает TypeError, а он в
    --state уносит с собой весь ответ, а не одну сессию.
    """
    return v if isinstance(v, (int, float)) and v > 0 else 0


def usage_of(sid):
    """(проценты контекста, доллары) сессии, 0 — «данных нет».

    Ноль и «ничего не потратила» тут не различить, и это правильный выбор:
    перехват статуслайна стоит не у каждой сессии, а показывать «$0 0%» значило
    бы утверждать, что сессия бесплатна и пуста.
    """
    try:
        with open(os.path.join(STATUS_DIR, sid + ".status.json"), encoding="utf-8") as fh:
            o = json.load(fh)
    except (OSError, ValueError):
        return 0, 0
    return int(num(o.get("contextPct"))), int(num(o.get("costUsd")))


def agent_of(sid, transcript="", turn_at=0):
    """Склеенные <id>.state.json, <id>.status.json и <id>.meta.json, или None.

    Склейка живёт здесь, а не у читателя: файлы локальные, а читатель —
    на другой машине через ssh. Деньги и проценты из статуслайна перекрывают
    те, что хук успел положить в state.json: status.json пишется чаще. На время
    это правило не распространяется — см. `updated` ниже.

    `transcript` нужен ровно для одного: датировать сессию, у которой
    state.json нет вовсе. Путь передаётся, а не читается — читать его незачем
    у всех, а только у таких сессий, и `or` ниже это и обеспечивает.

    `turn_at` — начало хода, посчитанное по транскрипту (`tail_facts`).
    Передаётся готовым по той же причине, по какой title и doing: хвост уже
    прочитан один раз, и памятка фактов бережёт двести чтений на каждом опросе.

    meta берётся после проверки на пустоту, и это не про экономию — читает её
    всё равно общий проход meta_all. Это про смысл: одна отметка старта записи
    агента не создаёт. «Запись есть» значит «хук хоть раз сработал», и по
    наличию записи читатель решает, есть ли о сессии что сказать.
    """
    def load(suffix):
        try:
            with open(os.path.join(STATUS_DIR, sid + suffix), encoding="utf-8") as fh:
                o = json.load(fh)
                return o if isinstance(o, dict) else {}
        except (OSError, ValueError):
            return {}

    state = load(".state.json")
    status = load(".status.json")
    if not state and not status:
        return None
    meta = meta_all(STATUS_DIR).get(sid) or {}

    out = {
        "state": state.get("state", ""),
        "event": state.get("event", ""),
        # Уведомление агента. Непусто только на attention — на запросе
        # разрешения это единственное, что о сессии известно: текста самого
        # вопроса там нет нигде. В остальное время пустая строка, и это ответ,
        # а не потеря.
        "message": state.get("message", ""),
        "summary": state.get("summary", ""),
        "lastSummary": state.get("lastSummary", ""),
        "prompt": state.get("prompt", ""),
        # Вопрос, на котором сессия стоит прямо сейчас. Живёт только пока вызов
        # AskUserQuestion не закрыт. Показывать его или нет, решает читатель по
        # состоянию: у запроса разрешения состояние такое же, а текста нет.
        "question": state.get("question", ""),
        "branch": state.get("branch", ""),
        "pr_url": state.get("pr_url", ""),
        "costUsd": num(status.get("costUsd", state.get("costUsd", 0))),
        "contextPct": num(status.get("contextPct", state.get("contextPct", 0))),
        # Только из state.json, и ни max(), ни откат на статуслайн здесь
        # неверны: `updated` у status.json — это время последней перерисовки
        # строки, а она идёт по таймеру (statusLine.refreshInterval), пока
        # открыт терминал. Такая отметка отвечает «процесс жив», а спрашивают
        # у неё «когда агент последний раз что-то сделал».
        #
        # Откат существовал ради сессий, поднятых до появления хука: других
        # отметок у них не было. Ценой оказалась ложь про живых. prune_state в
        # хуке роняет файлы, которых неделю не касались, — у открытой и
        # молчащей сессии state.json исчезает, а status.json переживает чистку,
        # потому что статуслайн его всё это время переписывает. Дальше откат
        # выдавал пульс за активность: сессия, молчащая с 1 августа, 13-го
        # стояла первой в сортировке `recent` с возрастом в секунду.
        #
        # Датирует такую сессию содержимое транскрипта — по той же причине, по
        # которой его же смотрит fresh_ids: mtime двигают служебные записи. Нет
        # транскрипта — ноль, «не знаем»; врать про секунду назад хуже.
        "updated": num(state.get("updated")) or int(last_message_at(transcript)),
        # Начало текущего хода — время последнего сообщения человека в
        # транскрипте, а отметка хука лишь запасной ход.
        #
        # Порядок именно такой, и это не вкусовщина. `turnAt` в state.json
        # пишет хук агента, а хук молчащий: перестал писать — и ход застыл,
        # тогда как сессия по-прежнему числится работающей. Транскрипт —
        # наблюдение, а не отметка о намерении, и врать ему нечем.
        #
        # Ноль от `tail_facts` значит «в хвосте человеческой записи не
        # нашлось», а не «хода не было»: длинный ход выталкивает реплику
        # человека за TAIL. Там отметка хука и остаётся единственным ответом —
        # и она же, скорее всего, верна: тот ход и правда начался давно.
        #
        # Статуслайн в этой развилке не участвует вовсе, как и у `updated`:
        # своего понятия о ходе у него нет.
        "turnAt": num(turn_at) or num(state.get("turnAt")),
        # Старт сессии в текущем виде: meta.json хук переписывает на каждом
        # SessionStart, а /clear, resume и сжатие — тоже старт.
        "started": num(meta.get("started")),
    }
    return out


def read_windows(path, now):
    """Файл оконного трекера: у какой сессии открыто окно, на чьей машине и
    какие раскладки он помнит.

    Файл необязательный и приезжает с другой машины, поэтому не доверяется
    ничему в нём. Нет файла, не разбирается json, нет ожидаемых ключей, отметка
    старше WINDOWS_TTL — возвращается пустота, и ни ошибки, ни строчки в stderr.
    Список сессий обязан пережить любой мусор в добавке: порченый файл должен
    стоить пометки, а не списка. Со снимками то же правило: кривая запись стоит
    себя, порченое поле — только поля. То же правило действует и с хоткеями
    проектов.
    """
    empty = ({}, "", 0, [], [], True, True, "")
    if not path:
        return empty
    try:
        with open(path, encoding="utf-8") as fh:
            o = json.load(fh)
    except (OSError, ValueError):
        return empty
    if not isinstance(o, dict):
        return empty
    if now - num(o.get("generated")) > WINDOWS_TTL:
        return empty
    raw = o.get("windows")
    if not isinstance(raw, dict):
        return empty
    out = {}
    for sid, w in raw.items():
        if not isinstance(sid, str) or not sid or not isinstance(w, dict):
            continue
        desktop = w.get("desktop")
        # bool в python — подкласс int, и `true` в json прошёл бы за номер стола.
        ok_desktop = isinstance(desktop, (int, float)) and not isinstance(desktop, bool)
        out[sid] = {
            "title": w.get("title") if isinstance(w.get("title"), str) else "",
            "desktop": desktop if ok_desktop else None,
            "lastSeen": num(w.get("lastSeen")),
            # Когда на окно этой сессии в последний раз перевели взгляд. Ни
            # здесь, ни у читателя такого знания нет: окна видит только трекер,
            # а читатель по этой отметке гасит зов «посмотри результат». Мусор и
            # отсутствие поля дают ноль — «не смотрели», — и пометки об окне не
            # стоят: она дороже.
            "focusedAt": num(w.get("focusedAt")),
            # Как зовут терминал, которому принадлежит окно. Читатель
            # (ccfzf-picker) различает по нему терминалы в строке поимённо: на
            # одной машине рядом живут Windows Terminal и WezTerm, и «окно
            # есть» на этот вопрос не отвечает. К общему виду имя здесь не
            # приводится намеренно: на Windows трекер называет файл
            # (`WindowsTerminal.exe`), на маке — приложение (`kitty`), и знает
            # оба вида сам читатель — у него и лежит таблица терминалов.
            # Пустая строка — трекер прежней версии; поле есть всегда, тем же
            # правилом, что и `focusedAt`: читателю дешевле пустая строка, чем
            # проверка на отсутствие ключа при каждом использовании.
            "app": w.get("app") if isinstance(w.get("app"), str) else "",
        }
    host = o.get("host") if isinstance(o.get("host"), str) else ""
    pid = int(num(o.get("pid")))

    snaps = []
    raw_snaps = o.get("snapshots")
    if isinstance(raw_snaps, list):
        for s in raw_snaps:
            if not isinstance(s, dict):
                continue
            sid = s.get("id")
            if not isinstance(sid, str) or not sid:
                continue
            sessions = []
            for m in s.get("sessions") if isinstance(s.get("sessions"), list) else []:
                if not isinstance(m, dict):
                    continue
                mid = m.get("id")
                if not isinstance(mid, str) or not mid:
                    continue
                sessions.append({
                    "id": mid,
                    "title": m.get("title") if isinstance(m.get("title"), str) else "",
                    "cwd": m.get("cwd") if isinstance(m.get("cwd"), str) else "",
                })
            snaps.append({"id": sid, "created": num(s.get("created")), "sessions": sessions})

    # Хоткеи проектов. Знать их отсюда неоткуда: список живёт в конфиге
    # windows11-manager, а регистрирует клавиши читатель. Здесь это просто ещё
    # одно поле, и недоверие к нему то же, что к окнам: запись без каталога или
    # без клавиши не значит ничего и выбрасывается молча.
    projects = []
    raw_projects = o.get("projects")
    if isinstance(raw_projects, list):
        for p in raw_projects:
            if not isinstance(p, dict):
                continue
            cwd = p.get("cwd")
            hotkey = p.get("hotkey")
            if not isinstance(cwd, str) or not cwd:
                continue
            if not isinstance(hotkey, str) or not hotkey:
                continue
            projects.append({
                "cwd": cwd,
                "name": p.get("name") if isinstance(p.get("name"), str) else "",
                "hotkey": hotkey,
            })

    # Умеет ли этот трекер поднимать окно по просьбе. Отсутствие поля — «умеет»:
    # Windows-трекер его не пишет и не должен, подъём там работал всегда. Мусор
    # читается так же, как отсутствие, — недоверие к файлу не заводит третьей
    # ветки поведения.
    focus = o.get("focus")
    if not isinstance(focus, bool):
        focus = True

    # Берётся ли менеджер этой машины открывать сессии и терминалы. Отсутствие
    # поля — «берётся», по той же причине, что и у `focus`: windows11-manager
    # его не пишет и не должен. Мак пишет False — терминалы там открывает сам
    # пикер, и просьба, ушедшая маку, не нашла бы разбирающего.
    open_session = o.get("openSession")
    if not isinstance(open_session, bool):
        open_session = True

    # Топик, на котором менеджер этой машины слушает просьбы. Пустая строка
    # значит «спроси свой конфиг» — так себя вёл читатель до появления поля, и
    # так он обязан вести себя с трекером прежней версии.
    mqtt_base = o.get("mqttBase")
    if not isinstance(mqtt_base, str):
        mqtt_base = ""

    return out, host, pid, snaps, projects, focus, open_session, mqtt_base


def window_sources(file_path, dir_path):
    """Пути ко всем файлам трекеров: старый одиночный плюс каталог.

    Порядок задан и потому предсказуем — одиночный файл, затем файлы каталога
    по имени. Из первого подходящего источника берутся верхние поля ответа, и
    случайный порядок означал бы, что они меняются от запуска к запуску.

    Отсутствие каталога — норма, а не отказ: на машине, где никто не переезжал
    на новую схему, источник по-прежнему один.
    """
    out = []
    if file_path:
        out.append(file_path)
    if dir_path:
        try:
            names = sorted(os.listdir(dir_path))
        except OSError:
            names = []
        out += [os.path.join(dir_path, n) for n in names if n.endswith(".json")]
    return out


def sort_windows(recs):
    """Окна одной сессии: свежайший взгляд первым.

    `focusedAt` — отметка человека («перевёл взгляд на окно»), `lastSeen` —
    отметка трекера («видел окно на своём тике»). Вторая и есть источник
    гонки: у одного трекера она растёт раз в секунду, у другого раз в
    тридцать, и первым по ней оказывается то одно окно, то другое.

    Имя машины третьим ключом — ради устойчивости, а не красоты: у двух окон,
    на которые ни разу не смотрели, первые два ключа равны, а читатель
    перерисовывает список раз в секунду.
    """
    return sorted(recs, key=lambda r: (-num(r.get("focusedAt")),
                                       -num(r.get("lastSeen")),
                                       str(r.get("host") or "").lower()))


def read_window_sources(file_path, dir_path, now):
    """Слить файлы трекеров в один вид: окна, машины, снимки, хоткеи.

    Трекеров теперь может быть несколько — по одному на машину, где открыты
    терминалы. «Чьё это окно» перестаёт быть свойством всего ответа и
    становится свойством записи: к каждой приписывается `host`, `pid` и
    `canFocus` того файла, из которого она приехала.

    Живость источника читается по непустому `host`: `read_windows` на любой
    отказ — нет файла, не разобрался json, протух `generated` — возвращает
    пустоту целиком. Второго признака заводить не нужно, и заводить его было
    бы вредно: два признака расходятся на первой же правке.

    Одну сессию могут показывать два трекера (её терминал открыт с обеих
    машин), и это не ошибка: работали на одной машине, продолжили на другой.
    Обе записи остаются — `windows[sid]` список, — а порядок задаёт
    `sort_windows`: свежайший взгляд первым. Прежде запись с меньшим
    `lastSeen` выбрасывалась, и читатель видел то одно окно, то другое.

    Верхние `host` / `pid` / `projects` остаются такими, какими были, потому
    что их читает не список окон, а проектные хоткеи. Берутся они у источника,
    который несёт хоткеи; если таких нет — у первого живого.

    Адрес просьбы (`mqttBase`) приписывается и записи окна, и записи машины:
    по первому выбирается, куда просить о подъёме, по второму — куда просить
    об открытии сессии. `openSession` живёт только в записи машины: у строки
    проекта окна нет вовсе, а спросить «кто откроет терминал» надо и про неё.

    Снимку приписывается машина, которая его сняла. Восстанавливают раскладку
    там же, где снимали, а список у читателя один на все источники: без
    владельца он не отличил бы свой снимок от чужого, и промах был бы молчащим —
    у публикации нет ответа.
    """
    windows = {}
    hosts = []
    snaps = []
    lead = None
    for path in window_sources(file_path, dir_path):
        w, host, pid, sn, pr, focus, open_session, mqtt_base = read_windows(path, now)
        if not host:
            continue
        hosts.append({"host": host, "pid": pid, "canFocus": focus,
                      "openSession": open_session, "mqttBase": mqtt_base})
        # Машина-владелец приписывается снимку здесь и только здесь: сам трекер
        # её не пишет — он не знает, что снимков бывает несколько источников.
        snaps += [dict(s, host=host, mqttBase=mqtt_base) for s in sn]
        if lead is None or (pr and not lead[2]):
            lead = (host, pid, pr)
        for sid, rec in w.items():
            windows.setdefault(sid, []).append(
                dict(rec, host=host, pid=pid, canFocus=focus, mqttBase=mqtt_base))
    windows = {sid: sort_windows(recs) for sid, recs in windows.items()}
    host, pid, projects = lead if lead else ("", 0, [])
    return windows, host, pid, snaps, projects, hosts


def usage_text(sid):
    """`46%  $56` фиксированной ширины: колонки в списке не должны разъезжаться."""
    pct, cost = usage_of(sid)
    return pad("%d%%" % pct if pct else "", 5) + pad("$%d" % cost if cost else "", 5)


def content_of(o):
    """Содержимое сообщения записи, или None — «сказать нечего».

    Проверка на словарь обязательна, и это не перестраховка: разбирается чужой
    файл, и `message` в порченой записи бывает строкой. Прежняя форма
    `(o.get("message") or {}).get("content")` на такой записи падала бы
    AttributeError — а падение здесь стоит не строки, а всего ответа `--state`:
    хвосты читаются в одном проходе по двум сотням файлов, и один мусорный
    байт погасил бы список целиком. Правило то же, что у read_windows: порченое
    поле стоит поля, а не списка.
    """
    if not isinstance(o, dict):
        return None
    message = o.get("message")
    return message.get("content") if isinstance(message, dict) else None


def is_human_message(o):
    """Запись транскрипта — сообщение человека, а не всё остальное под `user`.

    Под `type: "user"` в транскрипте лежит далеко не только человек. Замерено
    2026-08-15 на живой сессии: 109 записей `user`, из них человеческих 5.
    Остальное — результаты инструментов, которые агент кладёт сам себе, и
    служебные вставки. Приняв их за реплику человека, ход считался бы от
    последнего вызова grep, то есть не считался бы вовсе.

    Отсеиваются пять видов, и каждый по своему признаку:

    * `toolUseResult` — ответ инструмента, пришитый к записи целиком;
    * блок `tool_result` в содержимом — он же, со стороны сообщения;
    * `isMeta` — служебные вставки самого Claude Code (напоминания, вставки
      каталога), человек их не писал и не видел;
    * `isSidechain` — реплики субагента. Ход человека они не начинают:
      субагента позвал агент, а не человек;
    * `promptSource: "system"` / `origin.kind: "task-notification"` — отчёт
      субагента или фоновой команды. Приезжает он полноценной репликой:
      ни мета, ни сайдчейн, содержимое строкой, — и ход, посланному агентом
      отчётом, начинался бы заново каждые несколько минут. Ровно это и
      случилось в сессии a973 (2026-08-15): человек спросил в 22:39, ход
      датировался 23:19, пикер показывал минуту вместо сорока.

    Признака у последнего два, и это не запас. Замерено 2026-08-16 на 583
    уведомлениях в живых транскриптах: `origin.kind` стоит у всех,
    `promptSource` — у всех, кроме трёх записей 2.1.159. Первый держит старые
    транскрипты, второй называет вставку вообще, а не один её вид, — новый вид
    уведомления не потребует правки.

    Разбирается это по полям записи, а не по обёрткам в тексте: слэш-команду
    человек тоже посылает тегами (`<command-name>/do</command-name>`), и отсев
    «начинается с `<`» забрал бы вместе с уведомлением её.
    """
    if not isinstance(o, dict) or o.get("type") != "user":
        return False
    if o.get("toolUseResult") is not None or o.get("isMeta") or o.get("isSidechain"):
        return False
    if o.get("promptSource") == "system":
        return False
    origin = o.get("origin")
    if isinstance(origin, dict) and origin.get("kind") == "task-notification":
        return False
    content = content_of(o)
    # Нечитаемое содержимое — не человек. Настоящая реплика несёт либо строку,
    # либо список блоков; всё прочее означает порченую запись, а датировать ход
    # по ней значило бы врать про «секунду назад» на основании мусора.
    if not isinstance(content, (str, list)):
        return False
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "tool_result":
                return False
    return True


def stamp_of(o):
    """Время записи в epoch, или 0 — «у этой записи времени нет»."""
    ts = o.get("timestamp") if isinstance(o, dict) else None
    if not isinstance(ts, str):
        return 0.0
    try:
        # Тот же разбор, что в last_message_at, и по той же причине: `Z` сам
        # fromisoformat понимает только с 3.11, а агрегатор запускают через ssh
        # на машине, версию питона на которой никто не выбирал.
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


def tail_facts(path):
    """(title, latest activity, turn start) from the tail of the file.

    A manual title (custom-title) outranks the generated one (ai-title). Both
    records repeat throughout the file, so the tail almost always has them; a
    full pass happens only when the tail turned up no title at all.

    Начало хода — время последнего сообщения человека (`is_human_message`), и
    это честный признак в отличие от `turnAt`, который пишет хук агента: хук
    молчащий, перестал писать — и ход застыл, а сессия по-прежнему числится
    работающей.

    Ищется в том же обратном проходе, что и `doing`, а не вторым чтением файла:
    хвост уже прочитан, а на двухстах сессиях второй проход платился бы зря.
    Выход из цикла поэтому не по первой находке, а по обеим.

    Не нашлось — читается второй хвост, вчетверо шире (`TURN_TAIL`). Длинный
    ход выталкивает реплику человека за TAIL всегда (замер — у самой
    константы), и это ровно тот случай, когда на ход и смотрят; без второго
    прохода правило работало бы у простаивающих сессий и молчало у работающих.
    Платят за него только те, у кого первый хвост ничего не дал.

    Ноль после обоих проходов значит «не нашлось», а не «хода не было»:
    бывает и ход длиннее `TURN_TAIL`. Отличать одно от другого обязан
    вызывающий, и `agent_of` откатывается на отметку хука.

    Полный проход по файлу, который случается ради ненайденного заголовка,
    начала хода не уточняет намеренно: он бывает редко и не тогда, когда о нём
    просят, — и ответ выходил бы то глубоким, то нет, без видимой причины.
    """
    def pick(data):
        custom = ai = doing = ""
        turn_at = 0.0
        docs = {}
        lines = data.split(b"\n")
        for raw in lines:
            if b'-title"' not in raw:
                continue
            try:
                o = json.loads(raw)  # a truncated first tail line is dropped here
            except Exception:
                continue
            if o.get("type") == "custom-title":
                custom = o.get("customTitle") or custom
            elif o.get("type") == "ai-title":
                ai = o.get("aiTitle") or ai
        # Бумаги ищутся по сырой строке, до разбора JSON: путь встречается и в
        # тексте реплики, и в аргументах вызова инструмента, и во втором случае
        # никакого `text` у записи нет вовсе.
        #
        # Проход обратный, и первым найденным побеждает последнее упоминание:
        # сессия за день трогает и прошлый план, и новый, а спрошено «над чем
        # она сейчас».
        #
        # Выход из цикла по-прежнему по `doing и turn_at`, и бумаги его не
        # держат: у большинства сессий их нет вовсе (27 из 100 на живой
        # машине), и ждать их значило бы дочитывать хвост до конца всегда.
        for raw in reversed(lines):
            for m in DOC_RE.finditer(raw):
                # Групп две, потому что дороги у спеки две: длинная с
                # `superpowers/` и короткая без него. Совпала всегда ровно одна.
                kind = DOC_KINDS[m.group(1) or m.group(2)]
                docs.setdefault(kind, m.group(0).decode("utf-8", "replace"))
            try:
                o = json.loads(raw)
            except Exception:
                continue
            if not turn_at and is_human_message(o):
                turn_at = stamp_of(o)
            if not doing and o.get("type") in ("user", "assistant"):
                t = clean(text_of(content_of(o)))
                if t and not noisy(t):
                    doing = t[:200]
            if doing and turn_at:
                break
        return custom or ai, doing, turn_at, docs

    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            fh.seek(max(0, size - TAIL))
            title, doing, turn_at, docs = pick(fh.read())
            if not turn_at and size > TAIL:
                fh.seek(max(0, size - TURN_TAIL))
                turn_at = pick(fh.read())[2]
            if not title and size > TAIL:
                fh.seek(0)
                title = pick(fh.read())[0]
            return title, doing, turn_at, docs
    except OSError:
        return "", "", 0.0, {}


def free_session_name(base, taken):
    """Свободное имя новой сессии: занято — `-2`, дальше `-3`.

    Нумерация с двойки: первая сессия называется просто именем каталога, и
    `имя-1` рядом с ней читался бы как другая сессия.

    Правило то же, что у uniqueSessionName в ccfzf-picker
    (frontend-src/session-name.js). Общего кода нет — языки разные, и держать
    их в согласии приходится этим комментарием и парой одинаковых тестов.
    """
    name = base
    n = 2
    while name in taken:
        name = "%s-%d" % (base, n)
        n += 1
    return name


# Комментарий человека к сессии: три-четыре слова о том, что здесь делается.
# Предел не про вкус, а про файл: строка приезжает в список на каждой машине.
COMMENT_LIMIT = 200


def read_comments(path):
    """Общий список комментариев: id сессии → запись.

    Файл живёт на этой машине, а её `--state` читают по ssh пикеры всех машин
    сразу — значит, общим список выходит сам, без второго транспорта и без
    брокера. Ровно поэтому хранилище здесь, а не у пикера: у каждого из них
    свой диск, и синхронизировать их было бы нечем.

    Разбор белым списком, как у записи окна (`read_windows`): файл пишет чужая
    версия ccfzf с чужой машины, и незнакомая или кривая запись обязана
    потеряться молча, а не уронить ответ. Испорченный файл читается пустотой по
    той же причине.
    """
    try:
        with open(os.path.expanduser(path), encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(raw, dict):
        return {}
    out = {}
    for sid, rec in raw.items():
        if not isinstance(sid, str) or not UUID_RE.match(sid):
            continue
        if not isinstance(rec, dict):
            continue
        text = rec.get("text")
        if not isinstance(text, str) or not text.strip():
            continue
        out[sid] = {"text": text[:COMMENT_LIMIT],
                    "at": num(rec.get("at")),
                    "host": rec.get("host") if isinstance(rec.get("host"), str) else ""}
    return out


def set_comment(path, sid, text, now, host):
    """Записать или стереть комментарий. Ответ — удалось ли.

    Пустой текст стирает запись: отдельного «удалить» у комментария нет, и без
    этого убрать его было бы нечем.

    Пишется файл целиком, но из **прочитанного** словаря: пишут в него с
    разных машин, и перезапись одной записью стирала бы чужие молча.
    Атомарность даёт write_json — он кладёт через временный файл и rename, так
    что читатель половины списка не увидит никогда.

    Ключ проверяется по алфавиту id: он уезжает именем поля json и приезжает
    обратно на чужую машину, где опознать чужую строку будет уже некому.
    """
    if not isinstance(sid, str) or not UUID_RE.match(sid):
        return False
    all_ = read_comments(path)
    clean_text = (text or "").strip()[:COMMENT_LIMIT]
    if clean_text:
        all_[sid] = {"text": clean_text, "at": num(now), "host": host or ""}
    else:
        all_.pop(sid, None)
    write_json(os.path.expanduser(path), all_)
    return True


def count_prompts(path, start, prev):
    """Сколько раз человек писал в этой сессии — досчитывая, а не пересчитывая.

    Величина отвечает на вопрос, на который не отвечает процент контекста:
    тот говорит, сколько осталось до сжатия, и после `/compact` падает, а у
    сессии с миллионным окном и у соседки с двумястами тысячами значит разное.
    Число реплик только растёт и сравнимо между сессиями.

    Полный проход по транскрипту стоит дорого — замер на живой машине: 176 МБ
    на сто сессий, 0.45 с. Платить его на каждом опросе нельзя, но и не надо:
    транскрипт **только дописывают**, поэтому счёт продолжается с того места,
    где остановился. Полный проход случается один раз на сессию, а дальше
    читается только дописанное.

    Отсюда и второе возвращаемое — смещение, а не размер файла. Хвост живого
    транскрипта бывает без перевода строки: агент пишет запись прямо сейчас.
    Досчитав такую строку, счёт бы завысили; шагнув смещением за неё —
    потеряли бы реплику навсегда, второй раз её никто не прочтёт. Поэтому
    смещение двигается ровно на целые строки.

    Считаются только реплики человека (`is_human_message`): под `type: user`
    лежат ещё результаты инструментов, служебные вставки и отчёты субагентов —
    замер там же, 109 записей `user` на 5 человеческих.

    Файла нет — счёт остаётся прежним, а не обнуляется: транскрипт мог уехать с
    чисткой, строка списка при этом жива, и ноль читался бы как «человек тут
    ни разу ничего не спросил».
    """
    count, at = prev, start
    try:
        with open(path, "rb") as fh:
            fh.seek(start)
            for raw in fh:
                if not raw.endswith(b"\n"):
                    break  # запись ещё пишется — смещение за неё не шагает
                at += len(raw)
                if b'"user"' not in raw:
                    continue
                try:
                    o = json.loads(raw)
                except ValueError:
                    continue
                if isinstance(o, dict) and is_human_message(o):
                    count += 1
    except OSError:
        return prev, start
    return count, at


def last_message_at(path):
    """Когда в транскрипте последний раз появилась запись с временем.

    mtime для этого не годится, и это не мелочь. В хвосте живого файла лежат
    служебные записи без `timestamp` — last-prompt, custom-title, mode,
    pr-link, — и Claude Code переписывает их спустя дни после последнего
    разговора. Замерено 2026-08-08: два файла выглядели на 26 и 44 минуты при
    содержимом трёх- и семидневной давности, и обе сессии числились живыми.

    Читается тот же хвост, что у tail_facts, и по той же причине: полный проход
    по истории в сотни мегабайт стоил бы дороже всего списка. Хвост без единой
    записи с временем даёт 0 — «возраст неизвестен», и вызывающий обязан
    считать такой файл непригодным, а не свежим.

    Читается он до двух раз. Одна запись бывает длиннее всего хвоста — вставили
    картинку, выдали наружу большой grep, — и тогда в срез не попадает ни одной
    целой строки: разбирать нечего, ответ нулевой, а сессия в этот момент
    работает. Второй заход берёт окно кратно шире и такую запись захватывает
    целиком. Он случается только там, где первый уже ничего не нашёл, — то есть
    у единиц файлов, а не у двух сотен, и на горячий путь --state не выходит.
    """
    def scan(window):
        try:
            with open(path, "rb") as fh:
                fh.seek(max(0, size - window))
                lines = fh.read().split(b"\n")
        except OSError:
            return 0.0
        for raw in reversed(lines):
            try:
                o = json.loads(raw)  # обрезанная первая строка хвоста отсеется здесь
            except ValueError:
                continue
            ts = o.get("timestamp") if isinstance(o, dict) else None
            if not isinstance(ts, str):
                continue
            try:
                # `Z` разбирает и сам fromisoformat начиная с 3.11, но замена
                # оставляет функцию годной и на более старом питоне: агрегатор
                # запускается на чужой машине через ssh, и версию там никто не
                # выбирал.
                return datetime.datetime.fromisoformat(
                    ts.replace("Z", "+00:00")).timestamp()
            except ValueError:
                continue
        return 0.0

    try:
        size = os.path.getsize(path)
    except OSError:
        return 0.0
    at = scan(TAIL)
    if at or size <= TAIL:
        return at
    return scan(TAIL * 8)


UUID = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
UUID_RE = re.compile("^" + UUID + "$")
UUID_FILE_RE = re.compile("(" + UUID + r")\.jsonl$")

# Subcommands that run *around* sessions rather than being one: the daemon that
# hosts background agents, the pty host it forks per agent, the spare processes
# waiting to become one, and plain queries. Left in, they poison the fresh-start
# heuristic below — `claude agents` sitting in ~ claims the newest jsonl of
# ~/.claude/projects/-home-user as if a session were running there.
NOT_A_SESSION = {"daemon", "bg-pty-host", "bg-spare", "agents", "mcp", "update",
                 "install", "doctor", "config", "migrate-installer", "setup-token",
                 "plugin", "sandbox"}


def proc_args(pid):
    with open("/proc/%s/cmdline" % pid, "rb") as fh:
        return [a for a in fh.read().decode("utf-8", "ignore").split("\0") if a]


def parent_pid(pid):
    """ppid out of /proc/<pid>/stat — field 4, after a comm that may hold spaces."""
    try:
        with open("/proc/%s/stat" % pid) as fh:
            return fh.read().rsplit(")", 1)[1].split()[1]
    except (OSError, IndexError):
        return ""


def arg_value(args, flag):
    try:
        return args[args.index(flag) + 1]
    except (ValueError, IndexError):
        return ""


def is_claude(args):
    """`claude` on PATH execs a version-named binary, and that is what argv shows.

    Filtering on comm == "claude" used to be enough. It no longer is: a session
    started through the launcher runs as comm "2.1.220", so every background
    agent — and every session on a recent build — looked dead.
    """
    exe = args[0] if args else ""
    return os.path.basename(exe) == "claude" or "/.local/share/claude/versions/" in exe


def proc_tty(pid):
    """Управляющий терминал процесса — из fd 0, а не из /proc/<pid>/stat.

    tty_nr в stat — это номер устройства, который ещё надо разворачивать в
    путь; fd 0 у интерактивной сессии и так указывает прямо на /dev/pts/N.
    """
    try:
        target = os.readlink("/proc/%s/fd/0" % pid)
    except OSError:
        return ""
    return target if target.startswith("/dev/") else ""


def proc_cwd(pid):
    """Рабочий каталог процесса, пустая строка — не прочитался."""
    try:
        return os.readlink("/proc/%s/cwd" % pid)
    except OSError:
        return ""


def proc_started(pid):
    """Момент запуска процесса в тиках от загрузки, 0 — не прочиталось.

    Нужен против переиспользования номеров: pid, записанный хуком вчера, сегодня
    может принадлежать чему угодно, а пара (pid, момент запуска) уникальна в
    пределах одной загрузки.

    Второе поле /proc/*/stat — comm в скобках, и в нём бывают пробелы, поэтому
    строка режется по последней `") "`, а не по номеру поля. Дальше idx 19 —
    это 22-е поле, starttime.
    """
    try:
        with open("/proc/%s/stat" % pid) as fh:
            rest = fh.read().rpartition(") ")[2]
    except OSError:
        return 0
    try:
        return int(rest.split()[19])
    except (IndexError, ValueError):
        return 0


def proc_tmux(pid):
    """`session:window.pane`, если процесс живёт внутри tmux, иначе None.

    TMUX_PANE в окружении — это id панели (%3), а не адрес, по которому к ней
    можно присоединиться. Разворачивает его сам tmux; делается это здесь, а не
    у читателя, потому что читатель на другой машине и tmux ему недоступен.
    """
    try:
        with open("/proc/%s/environ" % pid, "rb") as fh:
            env = fh.read().decode("utf-8", "ignore").split("\0")
    except OSError:
        return None
    pane = ""
    for item in env:
        if item.startswith("TMUX_PANE="):
            pane = item[len("TMUX_PANE="):]
            break
    if not pane:
        return None
    try:
        out = subprocess.run(
            ["tmux", "display", "-p", "-t", pane,
             "#{session_name}:#{window_index}.#{pane_index}"],
            capture_output=True, text=True, timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    target = out.stdout.strip()
    return target or None


def zellij_server_name(args):
    """Имя зелийной сессии по argv её сервера, иначе "".

    Сервер живёт как `zellij --server <путь-сокета>`, и basename пути — это и
    есть имя сессии, то самое, которым её зовут в `zellij attach`.

    Имя бинаря проверяется отдельно от флага, и это не перестраховка:
    `--server` встречается в argv у кого угодно, а спутать чужой процесс с
    держателем сессии значило бы завести в списке строку, к которой не
    присоединиться.

    Воскресимые сессии (`EXITED - attach to resurrect`) сюда не попадают
    даром: процесса у них нет. Отдельного условия под них не нужно.
    """
    if not args or os.path.basename(args[0]) != "zellij":
        return ""
    try:
        i = args.index("--server")
    except ValueError:
        return ""
    path = args[i + 1] if i + 1 < len(args) else ""
    return os.path.basename(path.rstrip("/"))


def zellij_env_name(items):
    """Имя зелийной сессии по строкам /proc/<pid>/environ, иначе "".

    Сравнение вместе со знаком `=`: без него префикс поймал бы соседнюю
    переменную с более длинным именем.
    """
    tag = "ZELLIJ_SESSION_NAME="
    for item in items:
        if item.startswith(tag):
            return item[len(tag):]
    return ""


def proc_zellij(pid):
    """Имя зелийной сессии, в которой живёт процесс, иначе None.

    Вдвое тоньше proc_tmux, и разница не в стиле: tmux кладёт в окружение id
    панели (`%3`), а адрес, по которому к ней можно присоединиться,
    разворачивает только сам tmux — то есть подпроцессом. Zellij кладёт
    готовое имя, разворачивать нечего, и на горячий путь `--state` не выходит
    ни одного нового процесса.
    """
    try:
        with open("/proc/%s/environ" % pid, "rb") as fh:
            env = fh.read().decode("utf-8", "ignore").split("\0")
    except OSError:
        return None
    return zellij_env_name(env) or None


def hook_stamps(path=STATUS_DIR):
    """{id сессии: когда её хук писал в последний раз}.

    Берётся mtime файла, а не поле `updated` внутри: расходятся они меньше чем
    на секунду (замерено 2026-08-06: 0.3 с и 0.7 с), а один scandir по каталогу
    стоит долей миллисекунды против того, чтобы открыть и разобрать каждый файл.
    Разница в секунду здесь ни на что не влияет — отметки сравниваются между
    собой и со сроком в две минуты.

    Каталог чужой: его наполняют хуки, и в нём лежат ещё .status.json и
    .meta.json. Всё, что не похоже на `<uuid>.state.json`, пропускается молча,
    как и пропавший каталог: без хуков ccfzf работает как раньше.
    """
    out = {}
    tail = ".state.json"
    try:
        with os.scandir(path) as it:
            for entry in it:
                if not entry.name.endswith(tail):
                    continue
                sid = entry.name[:-len(tail)]
                if not UUID_RE.match(sid):
                    continue
                try:
                    out[sid] = entry.stat().st_mtime
                except OSError:
                    pass
    except OSError:
        pass
    return out


def boot_id():
    """Идентификатор текущей загрузки, пустая строка — не прочиталось."""
    try:
        with open("/proc/sys/kernel/random/boot_id") as fh:
            return fh.read().strip()
    except OSError:
        return ""


# Прочитанные <id>.meta.json, по каталогу. Читателей у них два — pid_owners
# (кто чем занят на самом деле) и старт сессии в --state, — а проход нужен
# один: файлов под сотню, а --state зовут раз в секунду, пока пикер на экране.
#
# Память на весь срок процесса, потому что процесс живёт ровно один тик: ccfzf
# — одноразовая команда, а не демон. Это и делает её «одним проходом», а не
# кэшем, которому нужен срок годности.
_METAS = {}


def meta_all(path):
    """{id сессии: содержимое <id>.meta.json} — один проход по каталогу.

    Ключ памяти — каталог, а не «уже читали»: тесты зовут читателей на разных
    временных каталогах внутри одного процесса, и общая память склеила бы их
    ответы, а проверки стали бы проверять её саму.

    Разбор здесь же, а не у читателя: испорченный файл и файл с чужим именем
    отбрасываются молча один раз, а не в каждом читателе по-своему.
    """
    if path in _METAS:
        return _METAS[path]
    tail = ".meta.json"
    out = {}
    try:
        with os.scandir(path) as it:
            names = [e.name for e in it if e.name.endswith(tail)]
    except OSError:
        names = []
    for name in names:
        sid = name[:-len(tail)]
        if not UUID_RE.match(sid):
            continue
        try:
            with open(os.path.join(path, name), encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            continue
        if isinstance(meta, dict):
            out[sid] = meta
    _METAS[path] = out
    return out


def pid_owners(path=STATUS_DIR, boot=None):
    """{pid: (id сессии, момент запуска процесса)} — кто чем занят на самом деле.

    Хук пишет `<id>.meta.json` в момент старта сессии, и смена id на ходу
    (`/clear`, сжатие) — тоже старт: замерено 2026-08-06, у переехавшего
    86d67681 в meta стоит `source: clear`. Значит в этих файлах лежит прямая
    связь процесса с той сессией, которую он пишет сейчас, — не догадка по
    соседям в каталоге и без срока годности: процесс либо жив, либо нет.

    У одного pid таких файлов столько, сколько раз внутри него сменился id,
    поэтому побеждает запись с самым поздним `started`.

    Чужая загрузка отсекается по boot_id: тики starttime считаются от неё, и
    без этой проверки вчерашняя запись совпала бы с сегодняшним процессом,
    занявшим тот же номер в ту же секунду после загрузки. Записи без pid — это
    файлы, написанные хуком старой версии; они просто не участвуют.

    Файлы читает meta_all — проход по каталогу общий с --state, потому что
    открыть их все нужно и там. Замерено 2026-08-06 — 1.9 мс на 69 файлов
    вчетверо большего размера, при опросе раз в секунду это ничего не стоит.
    """
    boot = boot_id() if boot is None else boot
    best = {}
    for sid, meta in meta_all(path).items():
        pid = meta.get("pid") or 0
        if not pid or not meta.get("boot") or meta["boot"] != boot:
            continue
        started = meta.get("started") or 0
        if pid in best and best[pid][0] >= started:
            continue
        best[pid] = (started, sid, meta.get("pidStarted") or 0)
    return {pid: (sid, tick) for pid, (_, sid, tick) in best.items()}


def reattribute_by_pid(live, procs, agents, owners, started_of=None):
    """Переезд по pid — тот же перенос, что и reattribute(), но без гадания.

    reattribute() ищет новый id среди соседей по каталогу и верит самой свежей
    отметке хука, поэтому вынужден жить со сроком годности: старая отметка уже
    ничего не доказывает. Здесь доказательство прямое — хук записал pid рядом с
    id в момент смены, — и устареть оно не может: пока процесс жив, он пишет
    именно эту сессию. Замерено 2026-08-06: 3049996 сутки писал 86d67681,
    отметка его хука к моменту замера остыла до 69 минут, и по ней переезд уже
    не срабатывал, а по pid срабатывает всегда.

    Момент запуска сверяется с тем, что записал хук: номера переиспользуются, и
    без сверки процесс, занявший освободившийся pid, унаследовал бы чужую
    сессию. Запись без момента запуска (0) принимается как есть — так себя ведут
    файлы от хука, который его ещё не писал.

    Возвращает (освобождённые id, улаженные id). Первое нужно live_by_hook(),
    второе — reattribute(): процесс, чью сессию уже назвали по pid, гадать по
    каталогу больше не о чем, и подставлять его под ошибку соседа незачем.
    """
    started_of = started_of or proc_started
    moved, resolved = set(), set()
    for sid in list(procs):
        pid = procs[sid].get("pid") or 0
        owner = owners.get(pid)
        if not owner:
            continue
        target, tick = owner
        if tick and started_of(pid) != tick:
            continue
        if target == sid:
            resolved.add(sid)
            continue
        if target in live:
            continue
        live.discard(sid)
        moved.add(sid)
        live.add(target)
        procs[target] = procs.pop(sid)
        if sid in agents:
            agents[target] = agents.pop(sid)
        resolved.add(target)
    return moved, resolved


def session_ids_in(cwd):
    """id всех транскриптов, лежащих в каталоге проекта этого cwd."""
    pattern = os.path.join(PROJECTS_DIR, mangle(cwd), "*.jsonl")
    return [os.path.basename(p)[:-len(".jsonl")] for p in glob.glob(pattern)]


def reattribute(live, procs, agents, stamps, now, ids_in=None, ttl=HOOK_LIVE_TTL,
                skip_procs=None):
    """Процесс, сменивший id на ходу, переезжает на тот, что пишется сейчас.

    Запасной путь к reattribute_by_pid(): работает там, где pid'а в meta нет —
    у сессий, поднятых до того, как хук научился его писать. Отсюда и догадка
    по каталогу, и срок годности; у прямого переезда по pid ни того, ни другого
    не нужно, поэтому улаженные им процессы сюда не попадают (skip_procs).

    argv называет id, с которого сессия начиналась (`--session-id`/`--resume`),
    а Claude Code меняет id внутри живого процесса — и после этого argv
    указывает на транскрипт, в который больше никто не пишет. Замерено
    2026-08-06: `claude --resume 6c6931cf` сутки как писал 86d67681. Флаг live
    стоял на мёртвом id, работающая сессия числилась мёртвой и пряталась из
    пикера (`onlyLive`), хотя окно терминала принадлежало именно ей.

    Кандидаты — соседи по каталогу проекта: id меняется внутри процесса, а cwd
    нет. Побеждает тот, чей хук писал позже argv-сессии, и только если он писал
    только что: отметка старше ttl значит «когда-то работала», а не «процесс
    сейчас на ней».

    Кандидат, уже занятый другим процессом, пропускается — иначе два процесса
    в одном каталоге сошлись бы на одном id. По той же причине занятость
    проверяется по текущему live: переезд, случившийся на предыдущем витке,
    виден следующему. Свежеосвобождённый id из этого же витка проверяется
    так же: без него следующий процесс из того же cwd садился бы на id,
    который только что освободили и с которого в этот транскрипт никто
    больше не пишет.

    Старый id из live убирается: процесс на нём не работает, а лишняя живая
    строка в пикере — это ровно тот симптом, ради которого всё и затевалось.

    Правит live/procs/agents на месте, а освобождённые id ещё и возвращает:
    их отметка хука ещё не остыла (короче HOOK_LIVE_TTL), и live_by_hook(),
    отработав следом, добавил бы их обратно тем же самым доводом — свежий
    хук — и свёл бы переезд на нет.
    """
    ids_in = ids_in or session_ids_in
    skip_procs = skip_procs or ()
    moved = set()
    for sid in list(procs):
        if sid in skip_procs:
            continue
        cwd = procs[sid].get("cwd") or ""
        if not cwd:
            continue
        best, best_at = "", stamps.get(sid, 0)
        for cand in ids_in(cwd):
            if cand == sid or cand in live or cand in moved:
                continue
            at = stamps.get(cand, 0)
            if at > best_at:
                best, best_at = cand, at
        if not best or now - best_at > ttl:
            continue
        live.discard(sid)
        moved.add(sid)
        live.add(best)
        procs[best] = procs.pop(sid)
        if sid in agents:
            agents[best] = agents.pop(sid)
    return moved


def live_by_hook(live, stamps, now, skip=None, ttl=HOOK_LIVE_TTL):
    """Свежая отметка хука — довод о жизни сама по себе.

    Хук стучит на каждый вызов инструмента работающего агента, поэтому выдаёт
    сессию и там, где /proc её не выдаёт: процесс поднят обёрткой, argv не
    называет ни старого id, ни нового, соседа по каталогу не нашлось.

    skip — id, которые reattribute() только что вынес из live на этом же
    витке. Их отметка хука ещё не остыла, и без этого исключения она была бы
    таким же доводом о жизни, как и у всех остальных — то есть id вернулся
    бы в live тем же вызовом, что его убрал, и дублирующая строка, ради
    ухода от которой затевался переезд, провисела бы в пикере весь HOOK_LIVE_TTL.

    Только добавляет, никогда не убавляет. Молчание ничего не значит: сессия,
    ждущая ответа человека, не шлёт хуков часами и при этом жива — и её
    единственный честный признак по-прежнему живой процесс.
    """
    skip = skip or ()
    for sid, at in stamps.items():
        if sid in skip:
            continue
        if now - at <= ttl:
            live.add(sid)


def fresh_ids(cwds, live, now, files_in=None, age_of=None):
    """K процессов в одном каталоге забирают K новейших транскриптов этого каталога.

    Последняя и самая слабая из трёх догадок о том, какую сессию пишет процесс:
    у него нет в argv ни `--session-id`, ни `--resume`, и опознать его нечем,
    кроме рабочего каталога. Так выглядит обычный `claude` без аргументов — то
    есть большинство.

    Возраст кандидата берётся у содержимого (`last_message_at`), а не у mtime.
    Причина — в самой last_message_at: mtime обновляют служебные записи, и по
    нему неделю не открывавшийся файл выглядит получасовым. По той же причине
    и сортировка идёт по содержимому: иначе «новейшим» оказался бы файл, чей
    mtime переписали последним.

    Швы `files_in` / `age_of` — для тестов, как `ids_in=` у reattribute:
    настоящие /proc и ~/.claude/projects в тесте не подделать.
    """
    files_in = files_in or (lambda cwd: glob.glob(
        os.path.join(PROJECTS_DIR, mangle(cwd), "*.jsonl")))
    age_of = age_of or last_message_at
    cutoff = now - FRESH_MAX_AGE
    for cwd, k in Counter(cwds).items():
        # Пара (возраст, путь), а не просто возраст: у двух файлов с одинаковым
        # временем порядок иначе зависел бы от того, что вернул glob.
        candidates = sorted(((age_of(f), f) for f in files_in(cwd)), reverse=True)
        for age, f in candidates:
            if k <= 0 or age < cutoff:
                break
            sid = os.path.basename(f)[:-6]
            if sid not in live:
                live.add(sid)
                k -= 1


def running_sessions():
    """(ids running right now, {id: {kind, parent}}) from /proc.

    The ccsessions heuristic, but over /proc instead of lsof: lsof costs more
    than a second on five processes, this costs milliseconds.

    Three argv shapes, in order of certainty:
    - `--session-id <uuid>` names the file being written outright. A background
      agent adds `--fork-session --resume <parent>.jsonl`, so the resumed path
      is its *parent*, not itself — matching --resume first would file a live
      agent under the session it forked from and hide it.
    - `--resume <uuid>` (or a path to one) pins the session exactly.
    - neither: a fresh start writes to the newest jsonl of its cwd directory,
      so K processes in one cwd claim the K newest files there. Newest by
      content, not by mtime — see fresh_ids.
    """
    live, fresh, agents, procs = set(), [], {}, {}
    # Держатели зелийных сессий и счётчик агентов по именам. Считается двумя
    # словарями, а не одним: сервер и живущий в нём claude встречаются в
    # произвольном порядке — /proc отдаёт pid'ы как попало, и счётчик обязан
    # пережить случай «агент найден раньше своего сервера».
    zellij, zellij_agents = {}, {}
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return live, agents, procs, []
    for pid in pids:
        try:
            args = proc_args(pid)
        except OSError:
            continue
        # Сервер зелийной сессии — не сессия агента, и дальше по циклу ему
        # делать нечего. Возраст берётся у каталога процесса: сверено с mtime
        # сокета сессии, совпадает секунда в секунду.
        server = zellij_server_name(args)
        if server:
            try:
                created = int(os.path.getmtime("/proc/%s" % pid))
            except OSError:
                created = 0
            zellij[server] = {"name": server, "created": created,
                              "pid": int(pid), "agents": 0}
            continue
        if not is_claude(args):
            continue
        # До отсева NOT_A_SESSION намеренно: счётчик отвечает на вопрос «есть
        # ли внутри чему пропасть», а демон фоновых агентов — это ровно оно.
        # Поле про свою сессию берётся здесь же, одним чтением на процесс.
        here = proc_zellij(pid)
        if here:
            zellij_agents[here] = zellij_agents.get(here, 0) + 1
        sub = args[1] if len(args) > 1 else ""
        if sub in NOT_A_SESSION or "--bg-spare" in args:
            continue

        resumed = arg_value(args, "--resume")
        resumed_id = ""
        if UUID_RE.match(resumed):
            resumed_id = resumed
        else:
            m = UUID_FILE_RE.search(resumed)
            resumed_id = m.group(1) if m else ""

        sid = arg_value(args, "--session-id")
        if not UUID_RE.match(sid):
            sid = ""
        parent = resumed_id if sid and resumed_id and resumed_id != sid else ""
        sid = sid or resumed_id

        if not sid:
            cwd = proc_cwd(pid)
            if cwd:
                fresh.append(cwd)
            continue

        live.add(sid)
        # Чем сессия занята: без pid её нельзя ни перехватить, ни хотя бы
        # честно показать человеку, что открытие будет не тихим resume.
        # cwd — не диагностика: по нему reattribute() ищет соседей по каталогу
        # проекта, когда id сессии сменился внутри процесса. Наружу поле не
        # уходит — режим state перечисляет то, что отдаёт, поимённо.
        procs[sid] = {"pid": int(pid), "tty": proc_tty(pid), "tmux": proc_tmux(pid),
                      "zellij": here, "cwd": proc_cwd(pid)}
        # A background agent is hosted by the daemon through a pty host; that
        # ancestry is the only honest mark of one. `--fork-session` alone is
        # not: it is a normal way to branch a session by hand.
        try:
            host = " ".join(proc_args(parent_pid(pid)))
        except OSError:
            host = ""
        if "bg-pty-host" in host:
            agents[sid] = {"kind": "background", "parent": parent}

    now = time.time()
    fresh_ids(fresh, live, now)

    # Порядок важен. Переезд идёт первым: ему нужно знать, кто занят на самом
    # деле, а live_by_hook раздаёт живость сессиям без процесса и тем самым
    # закрыл бы кандидатов для переезда. И только переезд умеет снимать живость
    # со сменившегося id — сам по себе он бы так и остался вторым chats-inspect
    # в списке. Второй проход обязан знать, что освободил первый: у только что
    # покинутого id отметка хука ещё моложе HOOK_LIVE_TTL, и live_by_hook,
    # не зная про skip, добавил бы его обратно тем же доводом — той самой
    # дублирующей строкой, ради ухода от которой reattribute вообще существует.
    # Переезд по pid идёт раньше переезда по отметке: он знает ответ, а не
    # выбирает лучшего из соседей, и потому не нуждается ни в сроке годности,
    # ни в догадке. Что он уладил, второй проход не трогает — иначе процесс,
    # чью сессию уже назвали точно, мог бы уехать к соседу, который закрылся
    # минуту назад и оставил после себя отметку свежее.
    stamps = hook_stamps()
    moved, resolved = reattribute_by_pid(live, procs, agents, pid_owners())
    moved |= reattribute(live, procs, agents, stamps, now, skip_procs=resolved)
    live_by_hook(live, stamps, now, skip=moved)
    for name, n in zellij_agents.items():
        if name in zellij:
            zellij[name]["agents"] = n
    # Порядок по имени, а не по времени: список читает отпечаток ответа
    # (poller.rs), и порядок, зависящий от обхода /proc, дёргал бы его без
    # всякой причины.
    return live, agents, procs, sorted(zellij.values(), key=lambda r: r["name"])


def scan_dirs():
    """[{dir, cwd, files: [(path, mtime)]}] over ~/.claude/projects."""
    out = []
    for d in glob.glob(os.path.join(PROJECTS_DIR, "*")):
        if not os.path.isdir(d):
            continue
        files = []
        for f in glob.glob(os.path.join(d, "*.jsonl")):
            try:
                files.append((f, os.path.getmtime(f)))
            except OSError:
                pass
        if not files:
            continue
        files.sort(key=lambda x: -x[1])
        cwd = dir_cwd([f for f, _ in files])
        if cwd:
            out.append({"dir": d, "cwd": cwd, "files": files})
    return out


def frozen_ids():
    try:
        with open(FROZEN, encoding="utf-8") as fh:
            return set(json.load(fh))
    except Exception:
        return set()


