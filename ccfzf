#!/usr/bin/env bash
# ccfzf — pick a Claude Code project and session with fzf.
#
#   ccfzf                       pick a project, then a session
#   ccfzf webapp                go straight to a project (mark from ~/.fzf-marks)
#   ccfzf ~/projects/js/webapp  the same, by path
#   ccfzf webapp --model opus   trailing arguments are passed on to claude
#   ccfzf --kiosk               run commands inside and return to the list
#   ccfzf --print               print the command instead of running it (zle widget)
#   ccfzf --session <id>        go straight into a session by id, no picker
#   ccfzf --dump                rewrite the sessions/projects json dumps and exit
#   ccfzf --state               print the whole picture as json on stdout, for a
#                               picker on another machine; no picker, no fzf
#   ccfzf --limit <n>           how many newest sessions to look at at all
#                               (default 100; applies to --state and --dump)
#
# Besides the sessions themselves the list offers: new session, up to three
# custom commands and a shell. Hotkeys act on the directory of the highlighted
# row: ctrl-d — shell, ctrl-s / ctrl-f / ctrl-g — commands 1/2/3. Configuration:
#   CCFZF_PROJECT_COMMAND[2,3]       what to run (first defaults to codex)
#   CCFZF_PROJECT_COMMAND_NAME[2,3]  label in the list (defaults to first word)
#   CCFZF_CLAUDE_COMMAND             the claude binary itself (default: claude)
#   CCFZF_SESSIONS_FILE              json dump for the window tracker: the
#                                    newest sessions (see --limit), all projects
#                                    (default ~/.ccfzf.sessions.json, empty — off);
#                                    --dump always rewrites it, --state only when
#                                    it is older than STATE_DUMP_MAX_AGE
#   CCFZF_PROJECTS_FILE              json dump of the project list
#                                    (default ~/.ccfzf.projects.json, empty — off)
#   CCFZF_WINDOWS_FILE               optional file *written by* a window tracker
#                                    elsewhere; --state uses it to say which
#                                    session has a terminal window open and when
#                                    its window was last looked at, and both
#                                    --state and --dump count such a session live
#                                    (default ~/.ccfzf.sessions.claude-wt.json)
#
# Data comes straight from ~/.claude/projects: the first jsonl line carries cwd,
# the tail carries the title and the latest activity. ccsessions is unfit here —
# its scan() reads every file in full (757 MB of history, 2-3 s per launch).
set -euo pipefail

MARKS="${FZF_MARKS_FILE:-$HOME/.fzf-marks}"

# The claude binary itself, so a wrapper or extra flags can be substituted.
# Treated as a shell fragment, like the project commands below.
CLAUDE_CMD="${CCFZF_CLAUDE_COMMAND:-claude}"

# What ccfzf sees is also dumped as json for the window tracker on the other
# machine: every project, and the newest --limit sessions across all of them.
# Set either to an empty string to turn that dump off.
SESSIONS_FILE="${CCFZF_SESSIONS_FILE-$HOME/.ccfzf.sessions.json}"
PROJECTS_FILE="${CCFZF_PROJECTS_FILE-$HOME/.ccfzf.projects.json}"

# Обратное направление: файл, который кладёт сюда оконный трекер с той машины,
# где сессии показаны в терминалах. Из него --state узнаёт, у какой сессии
# открыто окно, а --state и --dump — какую сессию считать живой вопреки
# транскрипту. Файл необязательный — нет его, и ответ просто беднее на одно
# поле. Пустая строка выключает чтение вовсе.
WINDOWS_FILE="${CCFZF_WINDOWS_FILE-$HOME/.ccfzf.sessions.claude-wt.json}"
# Каталог файлов трекеров: по одному на машину, где открыты терминалы. Старый
# одиночный файл читается по-прежнему и остаётся первым источником.
WINDOWS_DIR="${CCFZF_WINDOWS_DIR-$HOME/.ccfzf/windows}"

# Комментарии человека к сессиям, три-четыре слова о том, что здесь делается.
# Файл живёт на ЭТОЙ машине, а её --state читают по ssh пикеры всех машин
# сразу: общим список выходит сам, без второго транспорта и без брокера.
# Пустая строка выключает и чтение, и запись.
COMMENTS_FILE="${CCFZF_COMMENTS_FILE-$HOME/.ccfzf.comments.json}"

# Up to three custom commands run in the project directory: each adds a list
# entry and a hotkey. An empty value drops both the entry and the key.
# Note that --expect steals these keys from fzf: ctrl-f no longer moves the
# cursor in the query and ctrl-g no longer aborts (esc still does).
shell_key=ctrl-d
cmd_keys=(ctrl-s ctrl-f ctrl-g)
cmd_list=("${CCFZF_PROJECT_COMMAND-codex}" "${CCFZF_PROJECT_COMMAND2-}" "${CCFZF_PROJECT_COMMAND3-}")
cmd_names=(
  "${CCFZF_PROJECT_COMMAND_NAME:-${cmd_list[0]%% *}}"
  "${CCFZF_PROJECT_COMMAND_NAME2:-${cmd_list[1]%% *}}"
  "${CCFZF_PROJECT_COMMAND_NAME3:-${cmd_list[2]%% *}}"
)

usage() { sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; }

print_mode=0
kiosk=0
dump_only=0
state_only=0
comment_id=""
comment_host=""
project=""
session_id=""
# Сколько новейших сессий ccfzf вообще рассматривает. Прежние 200 были
# рассчитаны на список для человека; читателю дампа столько не нужно никогда,
# а платит за них и он (разбор), и машина-писатель (двести хвостов на каждый опрос).
limit=100
claude_args=()

while (($#)); do
  case "$1" in
    --print) print_mode=1; shift ;;
    -k|--kiosk) kiosk=1; shift ;;
    --dump) dump_only=1; shift ;;
    --state) state_only=1; shift ;;
    # Текст комментария приходит на stdin, а не аргументом: `ssh host cmd
    # args…` склеивает аргументы в строку для удалённого шелла, и комментарий
    # с `;` был бы командой. Второй аргумент — имя машины, назвавшей его: сама
    # она здесь не угадывается, ssh приходит с любой.
    --comment) comment_id="${2-}"; comment_host="${3-}"
      [[ -n $comment_id ]] || { echo "ccfzf: --comment requires a session id" >&2; exit 2; }
      shift 2; [[ -n $comment_host ]] && shift ;;
    --session) session_id="${2-}"; [[ -n $session_id && $session_id != -* ]] || { echo "ccfzf: --session requires a session id" >&2; exit 2; }; shift 2 ;;
    --session=*) session_id="${1#*=}"; [[ -n $session_id ]] || { echo "ccfzf: --session requires a session id" >&2; exit 2; }; shift ;;
    --limit) limit="${2-}"; [[ -n $limit ]] || { echo "ccfzf: --limit requires a positive integer" >&2; exit 2; }; shift 2 ;;
    --limit=*) limit="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; claude_args=("$@"); break ;;
    *) project="$1"; shift; [[ ${1:-} == "--" ]] && shift; claude_args=("$@"); break ;;
  esac
done

[[ $limit =~ ^[1-9][0-9]*$ ]] || { echo "ccfzf: --limit requires a positive integer" >&2; exit 2; }

((kiosk && print_mode)) && { echo "ccfzf: --kiosk and --print are mutually exclusive" >&2; exit 2; }
((dump_only && (kiosk || print_mode || ${#session_id} || ${#project}))) && {
  echo "ccfzf: --dump takes no other mode flags" >&2; exit 2;
}
((state_only && (kiosk || print_mode || dump_only || ${#session_id} || ${#project}))) && {
  echo "ccfzf: --state takes no other mode flags" >&2; exit 2;
}

# trailing arguments belong to claude, not to the project commands
claude_tail=""
((${#claude_args[@]})) && claude_tail=" $(printf '%q ' "${claude_args[@]}")"
claude_tail=${claude_tail% }

if [[ -n $comment_id ]]; then
  command -v python3 >/dev/null 2>&1 || { echo "ccfzf: python3 not found" >&2; exit 127; }
fi

if ((dump_only || state_only)); then
  command -v python3 >/dev/null 2>&1 || { echo "ccfzf: python3 not found" >&2; exit 127; }
else
  for dep in fzf python3; do
    command -v "$dep" >/dev/null 2>&1 || { echo "ccfzf: $dep not found" >&2; exit 127; }
  done
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
fi

read -r -d '' PY <<'PYEOF' || true
"""Collect Claude Code projects and sessions — a stripped-down ccsessions.

Nothing here reads a history in full: cwd sits in the first jsonl line, the
title (custom-title/ai-title) and the latest activity sit in the tail, and the
first prompt is looked up from the start of the file under a size cap.
"""
import datetime, glob, json, os, re, subprocess, sys, time
from collections import Counter

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
FROZEN = os.path.expanduser("~/.claude/ccsessions-frozen.json")
# Деньги и контекст сессии. Ни того, ни другого в транскрипте нет: размер окна
